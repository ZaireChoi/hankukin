# Door to Door — environment template
# Copy to .env.local and fill in. NEVER commit the real values.
# The real keys belong only in the deploy environment.

# ---------------------------------------------------------------------------
# 한국관광공사 TourAPI (공공데이터포털 data.go.kr)
# ---------------------------------------------------------------------------
# One decoded service key covers every language service you have been approved
# for. Apply per language — they are separate datasets on the portal.
#
#   국문      https://www.data.go.kr/data/15101578/openapi.do
#   영문      https://www.data.go.kr/data/15101753/openapi.do
#   중문 간체 https://www.data.go.kr/data/15101764/openapi.do
#   일문 / 중문 번체 — search "한국관광공사 일문 관광정보서비스" on the portal
#
# Use the DECODED key. The portal shows both; the encoded one double-escapes
# once your HTTP client encodes the query string again.
TOURAPI_SERVICE_KEY=

# Which languages you have been approved for (comma separated).
# The ingest script skips any language not listed here.
TOURAPI_LANGS=ko,en

# ---------------------------------------------------------------------------
# Not used yet — listed so nobody adds them silently.
# Per the handoff rule: no API key, paid service or partner program is enabled
# without the operator's explicit decision.
# ---------------------------------------------------------------------------
# ROUTING_API_KEY=        # road routing. Deliberately NOT connected: promising
#                         # an arrival time means owning its accuracy.
# MAP_TILE_KEY=           # commercial tiles. OSM public tiles have no SLA.
# KLOOK_AFFILIATE_AID=    # existing aid=131289 — add SubID per placement
# AGODA_AFFILIATE_CID=
# TRIPCOM_AFFILIATE_ID=
