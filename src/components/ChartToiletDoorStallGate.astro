---
/**
 * 화장실 세 자리 — 문 · 칸 · 개찰구.
 *
 * 왜 그렸나 (2026-09-06, Hangul 11편).
 *   화장실 안은 찍을 수 없는 자리다 — 식별 가능한 사람이 그대로 찍히고,
 *   찍어도 되는 빈 칸 사진은 「그냥 화장실」이라 주제를 말하지 못한다.
 *   그리고 이 기사의 요점은 물건이 아니라 **규칙이 붙는 자리**다 —
 *   문(누구 것인가·번호는 어디 있나) · 칸(휴지는 어디로·정지 단추·비상벨) ·
 *   개찰구(15분 안에 되돌아오면 기본운임을 다시 안 낸다).
 *   문패편(ChartDoorSigns)·PSD편(ChartPsdStationName)과 같은 판단.
 *
 *   칸 안의 배치는 시행령 제7조(휴지통 없음·위생용품 수거함)와
 *   법 제7조④(비상벨)의 서술만 그렸다. 비데 조작판의 낱말 넷은
 *   관찰이며 제조사마다 배치가 다르다 — 도표 안에 그렇게 적었다.
 *   15분·1,550원·1회권 제외는 서울시(2023-09-26)·국토교통부(2026-06-15) 자료다.
 */
interface Props { caption: string }
const { caption } = Astro.props;

const W = 760, H = 520;
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="Three places where Korean toilet rules attach. The door: a men's plate reading nam and a women's plate reading yeo, with a keypad lock whose code is printed on your receipt. The stall: toilet paper goes into the bowl, there is no bin by law in public toilets, a sanitary-product box stays in the women's stall, an emergency bell is on the wall, and the bidet panel's stop button, jeong-ji, is the one to find first. The gate: tap out, use the toilet, tap back in at the same station within fifteen minutes and the base fare of 1,550 won is not charged again; single-journey tickets are excluded and must ask staff at the emergency gate.">

    {/* ---------- 1. THE DOOR ---------- */}
    <text x="40" y="26" font-size="12" font-weight="700" fill="#8a827b" letter-spacing="0.08em">
      1 · THE DOOR — TWO SYLLABLES, AND A LOCK
    </text>

    <rect x="40" y="42" width="96" height="96" rx="8" fill="#12100f" />
    <text x="88" y="106" text-anchor="middle" font-size="52" font-weight="700" fill="#fffdfa">남</text>
    <text x="88" y="158" text-anchor="middle" font-size="13" font-weight="700" fill="#3c3733">nam</text>
    <text x="88" y="174" text-anchor="middle" font-size="11.5" fill="#6b6560">men · also 남자 · 男</text>

    <rect x="152" y="42" width="96" height="96" rx="8" fill="#fffdfa" stroke="#c9622e" stroke-width="2" />
    <text x="200" y="106" text-anchor="middle" font-size="52" font-weight="700" fill="#c9622e">여</text>
    <text x="200" y="158" text-anchor="middle" font-size="13" font-weight="700" fill="#c9622e">yeo</text>
    <text x="200" y="174" text-anchor="middle" font-size="11.5" fill="#6b6560">women · also 여자 · 女</text>

    {/* keypad */}
    <rect x="290" y="42" width="78" height="112" rx="6" fill="#efe9e1" stroke="#e0d8ce" />
    {[0,1,2].map((r) => [0,1,2].map((c) => (
      <rect x={300 + c*20} y={52 + r*20} width="16" height="16" rx="3" fill="#fffdfa" stroke="#c9c0b6" />
    )))}
    <rect x="300" y="112" width="56" height="16" rx="3" fill="#fffdfa" stroke="#c9c0b6" />
    <text x="329" y="145" text-anchor="middle" font-size="10.5" fill="#6b6560">keypad lock</text>

    {/* receipt */}
    <path d="M 400 44 h 92 v 96 l -8 6 -8 -6 -8 6 -8 -6 -8 6 -8 -6 -8 6 -8 -6 -8 6 -8 -6 -8 6 -8 -6 Z"
          fill="#fffdfa" stroke="#c9c0b6" stroke-width="1.5" />
    <path d="M 412 62 h 68 M 412 74 h 52 M 412 86 h 60" stroke="#e0d8ce" stroke-width="2" />
    <rect x="404" y="100" width="84" height="22" rx="3" fill="#c9622e" />
    <text x="446" y="115" text-anchor="middle" font-size="10" font-weight="700" fill="#fffdfa">비밀번호 ●●●●</text>
    <text x="446" y="158" text-anchor="middle" font-size="11.5" font-weight="700" fill="#c9622e">bi-mil-beon-ho</text>
    <text x="446" y="174" text-anchor="middle" font-size="11" fill="#6b6560">the code, on the receipt</text>

    <text x="520" y="64" font-size="12.5" fill="#3c3733">In many cafés and office</text>
    <text x="520" y="81" font-size="12.5" fill="#3c3733">buildings the toilet is in the</text>
    <text x="520" y="98" font-size="12.5" fill="#3c3733">corridor and the door is</text>
    <text x="520" y="115" font-size="12.5" fill="#3c3733">locked. The number is on</text>
    <text x="520" y="132" font-size="12.5" fill="#3c3733">the receipt or a card at the</text>
    <text x="520" y="149" font-size="12.5" fill="#3c3733">counter — what we observed,</text>
    <text x="520" y="166" font-size="12.5" fill="#3c3733">not a rule.</text>

    {/* ---------- 2. THE STALL ---------- */}
    <text x="40" y="214" font-size="12" font-weight="700" fill="#8a827b" letter-spacing="0.08em">
      2 · THE STALL — WHERE THE PAPER GOES, AND THE BUTTON TO FIND FIRST
    </text>

    {/* toilet */}
    <rect x="60" y="238" width="44" height="34" rx="4" fill="#fffdfa" stroke="#3c3733" stroke-width="1.5" />
    <ellipse cx="82" cy="292" rx="34" ry="18" fill="#fffdfa" stroke="#3c3733" stroke-width="1.5" />
    <ellipse cx="82" cy="292" rx="20" ry="9" fill="#efe9e1" stroke="#c9c0b6" />
    {/* paper roll + arrow into bowl */}
    <rect x="132" y="236" width="26" height="22" rx="4" fill="#fffdfa" stroke="#3c3733" stroke-width="1.5" />
    <path d="M 145 258 v 12 q 0 10 -12 14 l -26 6" fill="none" stroke="#4f8a5b" stroke-width="2.2" />
    <path d="M 113 285 l -8 5 3 -9" fill="#4f8a5b" />
    <text x="82" y="328" text-anchor="middle" font-size="12" font-weight="700" fill="#4f8a5b">휴지 → 변기</text>
    <text x="82" y="343" text-anchor="middle" font-size="11" fill="#6b6560">paper into the bowl</text>

    {/* crossed-out bin */}
    <path d="M 186 262 h 30 l -4 34 h -22 Z" fill="#fffdfa" stroke="#a09890" stroke-width="1.5" />
    <path d="M 182 262 h 38" stroke="#a09890" stroke-width="1.5" />
    <path d="M 180 256 L 224 302 M 224 256 L 180 302" stroke="#c9622e" stroke-width="3" />
    <text x="201" y="328" text-anchor="middle" font-size="12" font-weight="700" fill="#c9622e">휴지통 없음</text>
    <text x="201" y="343" text-anchor="middle" font-size="11" fill="#6b6560">no bin — by decree</text>

    {/* sanitary box (women's) */}
    <rect x="270" y="270" width="40" height="26" rx="3" fill="#efe9e1" stroke="#a09890" stroke-width="1.5" />
    <path d="M 276 270 v -6 h 28 v 6" fill="none" stroke="#a09890" stroke-width="1.5" />
    <text x="290" y="328" text-anchor="middle" font-size="11" font-weight="700" fill="#3c3733">위생용품 수거함</text>
    <text x="290" y="343" text-anchor="middle" font-size="11" fill="#6b6560">women's stalls</text>

    {/* emergency bell */}
    <circle cx="372" cy="270" r="14" fill="#c9622e" />
    <circle cx="372" cy="270" r="6" fill="#fffdfa" />
    <text x="372" y="328" text-anchor="middle" font-size="11" font-weight="700" fill="#3c3733">비상벨</text>
    <text x="372" y="343" text-anchor="middle" font-size="11" fill="#6b6560">not a flush</text>

    {/* bidet panel */}
    <rect x="430" y="236" width="290" height="76" rx="8" fill="#12100f" />
    <text x="442" y="256" font-size="10" fill="#a09890" letter-spacing="0.08em">BIDET PANEL — LAYOUT VARIES BY MAKER</text>
    {[
      { x: 442, ko: '세정', ro: 'se-jeong', en: 'wash', hi: false },
      { x: 512, ko: '비데', ro: 'bi-de', en: 'front wash', hi: false },
      { x: 582, ko: '건조', ro: 'geon-jo', en: 'dry', hi: false },
      { x: 652, ko: '정지', ro: 'jeong-ji', en: 'STOP', hi: true },
    ].map((b) => (
      <>
        <rect x={b.x} y="262" width="60" height="40" rx="6" fill={b.hi ? '#c9622e' : '#3c3733'} />
        <text x={b.x + 30} y="285" text-anchor="middle" font-size="17" font-weight="700" fill="#fffdfa">{b.ko}</text>
        <text x={b.x + 30} y="297" text-anchor="middle" font-size="8.5" fill={b.hi ? '#fffdfa' : '#c9c0b6'}>{b.en}</text>
      </>
    ))}
    <text x="442" y="330" font-size="11.5" fill="#3c3733">Four words cover most panels. Find</text>
    <text x="442" y="346" font-size="11.5" fill="#3c3733"><tspan font-weight="700" fill="#c9622e">정지</tspan> — stop — before you press anything else.</text>

    {/* ---------- 3. THE GATE ---------- */}
    <text x="40" y="384" font-size="12" font-weight="700" fill="#8a827b" letter-spacing="0.08em">
      3 · THE GATE — FIFTEEN MINUTES, SAME STATION, CARD ONLY
    </text>

    {/* timeline */}
    <path d="M 60 436 H 440" stroke="#c9c0b6" stroke-width="2" />
    <circle cx="60" cy="436" r="7" fill="#12100f" />
    <text x="60" y="460" text-anchor="middle" font-size="11.5" font-weight="700" fill="#12100f">tap out</text>
    <text x="60" y="474" text-anchor="middle" font-size="10.5" fill="#6b6560">하차</text>
    <rect x="190" y="418" width="120" height="36" rx="18" fill="#efe9e1" stroke="#e0d8ce" />
    <text x="250" y="441" text-anchor="middle" font-size="13" font-weight="700" fill="#3c3733">화장실</text>
    <circle cx="440" cy="436" r="7" fill="#4f8a5b" />
    <text x="440" y="460" text-anchor="middle" font-size="11.5" font-weight="700" fill="#4f8a5b">tap in again</text>
    <text x="440" y="474" text-anchor="middle" font-size="10.5" fill="#6b6560">재승차 · same station</text>
    <path d="M 60 412 H 440" stroke="#4f8a5b" stroke-width="1.5" stroke-dasharray="4 3" />
    <text x="250" y="406" text-anchor="middle" font-size="11.5" font-weight="700" fill="#4f8a5b">≤ 15 min → ₩1,550 base fare not charged again</text>

    <rect x="530" y="404" width="190" height="72" rx="6" fill="#fffdfa" stroke="#c9622e" stroke-width="1.5" />
    <text x="542" y="424" font-size="11.5" font-weight="700" fill="#c9622e">Single-journey ticket · 1회권</text>
    <text x="542" y="441" font-size="11" fill="#3c3733">Not covered. Press the intercom at</text>
    <text x="542" y="456" font-size="11" fill="#3c3733">the wide 비상게이트 and ask staff</text>
    <text x="542" y="471" font-size="11" fill="#3c3733">before you tap out.</text>

    <text x="40" y="496" font-size="11.5" fill="#3c3733">
      Once per journey. Seoul-run lines since 7 Oct 2023; Korail-run sections since 20 Jun 2026. AREX and Shinbundang: no such rule.
    </text>

    <text x="40" y={H - 12} font-size="11.5" fill="#a09890">
      Our own illustration. Stall layout follows the decree text; the bidet words are what we have seen on panels, and layouts differ.
    </text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; }
  figcaption { margin-top: 0.65rem; font-size: 0.86rem; line-height: 1.55; color: #6b6560; }
</style>
