---
/**
 * 단풍 절정 예상일 — 북 → 남 순서.
 *
 * 봄과 반대 방향이라는 것이 이 도표의 전부다.
 * 벚꽃은 남에서 북으로 올라오고, 단풍은 북에서 남으로 내려온다.
 * 표로 적으면 그냥 날짜 넷이지만, 가로축에 놓으면 방향이 보인다.
 *
 * 출처: 산림청 2025년 단풍 절정 예측 (절정 = 산 전체의 50% 이상 착색).
 */
interface Props { caption: string }
const { caption } = Astro.props;

// (이름, 지역, 10월 1일 기준 경과일, 위도 순서)
const peaks = [
  { name: 'Seoraksan',  region: 'Gangwon · north-east',   day: 25, label: '25 Oct' },
  { name: 'Songnisan',  region: 'Chungbuk · centre',      day: 27, label: '27 Oct' },
  { name: 'Naejangsan', region: 'Jeonbuk · south-west',   day: 37, label: '6 Nov'  },
  { name: 'Gayasan',    region: 'Gyeongnam · south-east', day: 42, label: '11 Nov' },
];

const W = 760, H = 268, L = 178, R = 86, T = 46, B = 44;
const D0 = 8, D1 = 46;                       // 10월 8일 ~ 11월 15일
const x = (d: number) => L + (W - L - R) * (d - D0) / (D1 - D0);
const rowY = (i: number) => T + 16 + i * 44;

const ticks = [
  { d: 10, t: '10 Oct' }, { d: 20, t: '20 Oct' }, { d: 31, t: '31 Oct' },
  { d: 41, t: '10 Nov' },
];
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="Predicted peak autumn foliage dates for four Korean mountains in 2025: Seoraksan in the north-east on 25 October, Songnisan in the centre on 27 October, Naejangsan in the south-west on 6 November, and Gayasan in the south-east on 11 November. The dates run later as the mountains run further south, the opposite direction to cherry blossom.">

    {ticks.map((k) => (
      <>
        <line x1={x(k.d)} y1={T} x2={x(k.d)} y2={H - B} stroke="#e5ddd3" stroke-width="1" />
        <text x={x(k.d)} y={H - B + 18} text-anchor="middle" font-size="11.5" fill="#6b6560">{k.t}</text>
      </>
    ))}

    <text x={L} y={26} font-size="11.5" font-weight="700" fill="#9a6b3f"
          letter-spacing="0.06em">NORTH</text>
    <text x={L} y={H - 10} font-size="11.5" font-weight="700" fill="#9a6b3f"
          letter-spacing="0.06em">SOUTH</text>
    <line x1={L - 22} y1={T + 4} x2={L - 22} y2={H - B - 4} stroke="#c9622e"
          stroke-width="1.4" opacity="0.45" />
    <path d={`M${L - 26},${H - B - 12} L${L - 22},${H - B - 4} L${L - 18},${H - B - 12}`}
          fill="none" stroke="#c9622e" stroke-width="1.4" opacity="0.45" />

    {peaks.map((p, i) => (
      <>
        <text x={L - 34} y={rowY(i) + 1} text-anchor="end" font-size="13"
              font-weight="600" fill="#12100f">{p.name}</text>
        <text x={L - 34} y={rowY(i) + 15} text-anchor="end" font-size="10.5"
              fill="#8a827b">{p.region}</text>
        <line x1={L} y1={rowY(i)} x2={x(p.day)} y2={rowY(i)}
              stroke="#e0d4c4" stroke-width="2" stroke-linecap="round" />
        <circle cx={x(p.day)} cy={rowY(i)} r="7" fill="#c9622e" />
        <text x={x(p.day) + 14} y={rowY(i) + 4} font-size="12.5"
              font-weight="700" fill="#c9622e">{p.label}</text>
      </>
    ))}

    <path d={`M${x(25)},${rowY(0)} C${x(30)},${rowY(1)} ${x(32)},${rowY(2)} ${x(42)},${rowY(3)}`}
          fill="none" stroke="#c9622e" stroke-width="1.6" stroke-dasharray="4 4" opacity="0.5" />
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; }
  figcaption {
    margin-top: 0.65rem; font-size: 0.86rem; line-height: 1.55; color: #6b6560;
  }
</style>
