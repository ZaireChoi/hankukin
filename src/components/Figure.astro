---
/**
 * 사진 + 출처 표시.
 *
 * 출처 표기는 선택이 아니다. 공공누리 제1유형·제3유형 모두 '출처표시' 가 조건이고,
 * 표시하지 않으면 라이선스 위반이다. 그래서 credit 을 필수 prop 으로 둔다 —
 * 빠뜨리면 빌드가 아니라 눈으로 바로 보인다.
 */
import { Image } from 'astro:assets';

const LICENSE_LABEL = {
  'kogl-1': 'KOGL Type 1',
  'kogl-3': 'KOGL Type 3 (no modification)',
  'cc0': 'CC0',
  'cc-by': 'CC BY',
  'cc-by-sa': 'CC BY-SA',
  'own': 'Own work',
};

const { src, alt, credit, license, sourceUrl, caption, widths = [640, 960, 1280] } = Astro.props;

/**
 * 변경금지 라이선스는 Astro 최적화를 태우지 않는다 (2026-08-14).
 *
 * 공공누리 제3유형은 '출처표시 + 변경금지' 다.
 * Astro 의 <Image> 는 리사이즈하고 WebP 로 변환한다 — 그것도 변경이다.
 * 다운로드 스크립트에서는 리사이즈를 막아놓고 화면에서 변환하면 소용이 없다.
 *
 * 그래서 3유형은 원본 파일을 그대로 내보낸다. 페이지가 조금 무거워지지만
 * 라이선스를 지키는 쪽이 먼저다.
 */
const NO_MODIFY = new Set(['kogl-3']);
const mustKeepOriginal = NO_MODIFY.has(license);
---
<figure class="fig">
  {mustKeepOriginal
    ? <img src={src.src} alt={alt} width={src.width} height={src.height}
           loading="lazy" decoding="async" />
    : <Image src={src} alt={alt} widths={widths}
             sizes="(min-width: 800px) 760px, 100vw" loading="lazy" decoding="async" />}
  <figcaption>
    {caption && <span class="cap">{caption}</span>}
    <span class="credit">
      {sourceUrl
        ? <a href={sourceUrl} rel="noopener nofollow" target="_blank">{credit}</a>
        : credit}
      {license && <> · {LICENSE_LABEL[license] ?? license}</>}
    </span>
  </figcaption>
</figure>

<style>
  .fig { margin: 2rem 0; }
  .fig :global(img) {
    width: 100%; height: auto; border-radius: 6px; display: block;
  }
  figcaption {
    margin-top: .5rem; font-size: .82rem; line-height: 1.5;
    color: var(--muted, #666);
  }
  .cap { display: block; color: var(--text, #222); margin-bottom: .15rem; }
  .credit a { color: inherit; }
</style>
