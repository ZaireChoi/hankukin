---
/**
 * 시네마테크KOFA 에서 화면에 실제로 뜨는 것 — 영화의 국적 × E 표시.
 *
 * 왜 그렸나 (2026-08-19, Scenes: 영어자막 편).
 *   이 기사의 요점은 「E 를 찾아라」 한 줄이 아니다.
 *   **한국영화만 자막이 없다**는 비대칭이 요점이고, 그건 두 축을 겹쳐야 보인다.
 *   범례는 문장 두 개로 적혀 있어서(「E 영어자막」 / 「한국영화를 제외한
 *   모든 상영작에는 한글 자막이 제공됩니다」) 읽는 사람이 머릿속에서 곱해야 한다.
 *   그 곱셈을 대신 해주는 것이 이 격자다.
 *
 *   방(房)편은 등식(=), 종로편은 2행 대조, 이 편은 **2×2 격자**다.
 *   같은 구도를 세 번 쓰지 않는다.
 *
 * 네 칸은 전부 범례에서 직접 나온다. 우리가 보탠 판단은 없다.
 * 왼쪽 위 칸만 색을 뺀 것은 그 칸이 **아무것도 안 뜨는 칸**이기 때문이다.
 */
interface Props { caption: string }
const { caption } = Astro.props;

/*
 * 2026-08-19. 처음 그린 뒤 dist 에서 꺼내 PNG 로 렌더해 보고 두 군데를 고쳤다.
 * 빌드는 통과했는데 그림은 읽을 수 없는 상태였다 — 지시문이 경고한 그대로다.
 *
 *   ① H=330 이라 아래 행(206~298)과 맺음 문장(304·321)이 붙어서 겹쳐 보였다.
 *      → H 를 386 으로 올리고 맺음 문장을 344·363 으로 내렸다.
 *   ② 오른쪽 아래 칸을 fill-opacity 로 옅게 깔고 **같은 색 글자**를 얹었다.
 *      브라우저에서는 13% 라 읽히지만, 옅은 색을 무시하는 렌더러에서는 글자가 통째로 사라진다.
 *      → 불투명도 대신 **옅은 색을 직접 지정**한다. 어디서 열어도 같은 그림이 된다.
 */
const W = 760, H = 386;

const LX = 30;
const C1 = 246, C2 = 506;   // 열 시작
const CW = 224;
const R1 = 96, R2 = 212, RH = 92;

const MUTED = '#b0442e';
const ACCENT = '#c9622e';
const ACCENT_PALE = '#f7e6da';   // ACCENT 13% 를 종이색 위에 미리 섞어 둔 값
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="A grid showing what appears on screen at Cinematheque KOFA. A Korean film with no E mark shows no subtitles at all. A Korean film marked E shows English subtitles. A film from anywhere else with no E mark shows Korean subtitles. A film from anywhere else marked E shows Korean subtitles plus English.">

    <text x={LX} y="28" font-size="12" font-weight="700" fill="#8a827b" letter-spacing="0.08em">
      WHAT IS ON THE SCREEN AT CINEMATHEQUE KOFA
    </text>
    <text x={LX} y="50" font-size="12.5" fill="#6b6560">
      Two things decide it: where the film is from, and whether the listing carries an E.
    </text>

    {/* 열 머리 */}
    <text x={C1 + CW / 2} y={R1 - 14} text-anchor="middle" font-size="12.5" font-weight="700" fill="#8a827b">
      NO E ON THE LISTING
    </text>
    <text x={C2 + CW / 2} y={R1 - 14} text-anchor="middle" font-size="12.5" font-weight="700" fill={ACCENT}>
      MARKED E
    </text>

    {/* 행 1 — 한국영화 */}
    <text x={LX} y={R1 + 40} font-size="15" font-weight="700" fill="#12100f">A Korean film</text>
    <text x={LX} y={R1 + 60} font-size="12" fill="#8a827b">the reason most</text>
    <text x={LX} y={R1 + 76} font-size="12" fill="#8a827b">visitors came</text>

    <rect x={C1} y={R1} width={CW} height={RH} rx="5" fill="#efe9e1" stroke={MUTED} stroke-width="1.6" />
    <text x={C1 + CW / 2} y={R1 + 44} text-anchor="middle" font-size="21" font-weight="700" fill={MUTED}>Nothing</text>
    <text x={C1 + CW / 2} y={R1 + 68} text-anchor="middle" font-size="12" fill="#6b6560">no subtitles in any language</text>

    <rect x={C2} y={R1} width={CW} height={RH} rx="6" fill="#12100f" />
    <text x={C2 + CW / 2} y={R1 + 44} text-anchor="middle" font-size="21" font-weight="700" fill="#fffdfa">English</text>
    <text x={C2 + CW / 2} y={R1 + 68} text-anchor="middle" font-size="12" font-weight="700" fill="#9fc7ae">this is the one to look for</text>

    {/* 행 2 — 그 밖의 영화 */}
    <text x={LX} y={R2 + 40} font-size="15" font-weight="700" fill="#12100f">A film from</text>
    <text x={LX} y={R2 + 60} font-size="15" font-weight="700" fill="#12100f">anywhere else</text>
    <text x={LX} y={R2 + 80} font-size="12" fill="#8a827b">the archive screens many</text>

    <rect x={C1} y={R2} width={CW} height={RH} rx="5" fill="#fffdfa" stroke="#e0d8ce" />
    <text x={C1 + CW / 2} y={R2 + 44} text-anchor="middle" font-size="21" font-weight="700" fill="#3c3733">Korean</text>
    <text x={C1 + CW / 2} y={R2 + 68} text-anchor="middle" font-size="12" fill="#6b6560">Korean subtitles, always</text>

    <rect x={C2} y={R2} width={CW} height={RH} rx="5" fill={ACCENT_PALE} stroke={ACCENT} stroke-width="1.6" />
    <text x={C2 + CW / 2} y={R2 + 44} text-anchor="middle" font-size="20" font-weight="700" fill="#8f421d">Korean + English</text>
    <text x={C2 + CW / 2} y={R2 + 68} text-anchor="middle" font-size="12" font-weight="700" fill="#8f421d">both lines are provided</text>

    <text x={LX} y={H - 42} font-size="12.5" fill="#3c3733">
      The awkward corner is the top left. A Korean film without an E is the only combination that
    </text>
    <text x={LX} y={H - 23} font-size="12.5" fill="#3c3733">
      leaves the screen bare — which is why the E is the one mark worth hunting for.
    </text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; }
  figcaption { margin-top: 0.65rem; font-size: 0.86rem; line-height: 1.55; color: #6b6560; }
</style>
