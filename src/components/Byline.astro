---
import { pageHref } from '../config/links.mjs';
/**
 * 기사 하단 꼬리말 — 저자·확인일·편집방침·오류신고를 **한 덩어리**로 적는다.
 *
 * 왜 아래인가 (2026-08-16). 외부 평가 두 건이 같은 것을 최대 약점으로 꼽았다 —
 * 사이트 뒤에 사람이 있는지 알 수 없다는 것. 조직명은 사람이 아니다.
 * 다 읽은 사람이 '누가 썼나' 를 궁금해할 때가 이 블록이 일하는 순간이고,
 * 첫머리에 두면 자기소개가 기사를 가린다.
 *
 * 왜 상자를 없앴나 (2026-08-22). 운영자 지적으로 시작했다 —
 * 「글 하단에 이것들은 색상이나 강조박스 같은게 필요없지 않나」.
 * 열어 보니 상자가 **넷**이었다: 확인일 고지 · 저자 · 편집방침 · 오류신고.
 * 넷 다 베이지 바탕에 왼쪽 세로줄이라 **어느 것도 강조가 되지 못했다.**
 * 전부 강조하면 아무것도 강조되지 않는다.
 *
 * 게다가 셋째 상자(policyNote)는 둘째 상자 안의 문장(aiNote)과 **같은 말이었다.**
 * 상자로 갈라놓아서 안 보였을 뿐이다. ui.mjs 의 주석에 자세히 적었다.
 *
 * 지금 모양.
 *   가는 선 하나로 본문과 끊고, 그 아래는 배경도 테두리도 없다.
 *   **저자 이름만** 굵기와 주황으로 구분한다 — 여기서 유일하게 찾는 것이 그것이니까.
 *   나머지는 --font-serif 이탤릭. 기사 제목(h1)이 쓰는 바로 그 서체다.
 *   같은 목소리로 글을 열고 닫는 셈이고, 이탤릭이라 본문과 섞이지 않는다.
 *   (Times New Roman 은 쓰지 않았다. Newsreader 옆에 놓으면 고른 것이 아니라
 *    워드 기본값을 그대로 둔 것처럼 보인다.)
 *
 * 확인일 고지가 여기로 온 이유.
 *   전에는 SourceList 안에 있었다. 그런데 그 문장은 출처 목록에 대한 말이 아니라
 *   **이 페이지 전체에 대한 말**이다 — 「언제 확인했고, 그 뒤로는 우리도 모른다」.
 *   출처 밑에 두면 출처만 오래됐다는 뜻으로 읽힌다.
 */
import { AUTHOR } from '../config/author.mjs';
import { t } from '../config/ui.mjs';
const { lang = 'en', checkedAt } = Astro.props;
const fmt = (d) => new Date(d).toISOString().slice(0, 10);
---
<aside class="colophon">
  <p class="by">{t(lang, 'byline.writtenBy')} <a href={pageHref(lang, 'author')} rel="author">{AUTHOR.name}</a></p>
  {lang === 'en' && <p class="what">{AUTHOR.short}</p>}

  {checkedAt && <p class="fine">{t(lang, 'article.verifyNotice')(fmt(checkedAt))}</p>}

  <p class="fine">
    {t(lang, 'byline.colophonLead')}<a href={pageHref(lang, 'editorial-policy')}>{t(lang, 'byline.colophonPolicy')}</a>{t(lang, 'byline.colophonTail')}{' '}
    <a href={pageHref(lang, 'ledger')}>{t(lang, 'byline.ledger')}</a>
  </p>

  <p class="fine">
    {t(lang, 'byline.spotted')}{' '}
    <a href={pageHref(lang, 'contact')}>{t(lang, 'byline.reportError')}</a>.
  </p>
</aside>
<style>
  /* 상자가 아니라 선 하나. 본문과 끊기면 되고, 그 이상은 필요 없다. */
  .colophon { margin: 2.6rem 0 0; padding: 1.15rem 0 0; border-top: 1px solid var(--line); }

  /* 여기서 유일하게 강조되는 것 — 사람 이름 */
  .by { margin: 0 0 0.25rem; font-size: 0.98rem; font-weight: 700; color: var(--ink); }
  .by a { color: #c9622e; text-decoration: none; }
  .by a:hover { text-decoration: underline; }

  .what {
    margin: 0 0 0.85rem;
    font-family: var(--font-serif); font-style: italic;
    font-size: 0.9rem; line-height: 1.6; color: var(--ink-2);
  }

  /* 고지·방침·신고 — 읽히되 기사를 이기지 않는다 */
  .fine {
    margin: 0 0 0.5rem;
    font-family: var(--font-serif); font-style: italic;
    font-size: 0.83rem; line-height: 1.65; color: var(--ink-3);
  }
  .fine:last-child { margin-bottom: 0; }
  .fine a { color: var(--ink-3); text-decoration: underline; text-underline-offset: 2px; }
  .fine a:hover { color: var(--accent); }
</style>
