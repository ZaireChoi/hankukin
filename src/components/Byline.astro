---
import { pageHref } from '../config/links.mjs';
/**
 * 기사 하단 저자 표시.
 *
 * 왜 (2026-08-16). 외부 평가 두 건이 같은 것을 최대 약점으로 꼽았다 —
 * 사이트 뒤에 사람이 있는지 알 수 없다는 것. 조직명은 사람이 아니다.
 *
 * 위에 놓지 않고 **아래**에 둔다. 다 읽은 사람이 '누가 썼나' 를 궁금해할 때가
 * 이 블록이 일하는 순간이고, 첫머리에 두면 자기소개가 기사를 가린다.
 */
import { AUTHOR } from '../config/author.mjs';
import { t } from '../config/ui.mjs';
const { lang = 'en' } = Astro.props;
---
<aside class="byline">
  <p class="by">{t(lang, 'byline.writtenBy')} <a href={pageHref(lang, 'author')} rel="author">{AUTHOR.name}</a></p>
  {lang === 'en' && <p class="what">{AUTHOR.short}</p>}
  <p class="how">
    {t(lang, 'byline.aiNote')}{' '}
    <a href={pageHref(lang, 'ledger')}>{t(lang, 'byline.ledger')}</a>
  </p>
</aside>
<style>
  .byline { margin: 2.5rem 0 0; padding: 1.1rem 1.25rem; background: #fbf7f1;
            border-left: 3px solid #c9622e; border-radius: 0 5px 5px 0; }
  .by { margin: 0 0 0.3rem; font-size: 1rem; font-weight: 700; color: #12100f; }
  .by a { color: #c9622e; text-decoration: none; }
  .what { margin: 0 0 0.6rem; font-size: 0.9rem; line-height: 1.6; color: #4a443f; }
  .how { margin: 0; font-size: 0.79rem; line-height: 1.58; color: #8a827b; }
  .how a { color: #8a827b; }
</style>
