---
/**
 * 데이터만 있는 eSIM 으로 되는 것과 안 되는 것.
 *
 * 왜 그렸나 (2026-08-16).
 *   eSIM 은 사진으로 설명할 수 없다. 실물이 없기 때문이다.
 *   상품 사진은 QR 코드 그림이고 그건 아무것도 설명하지 않는다.
 *
 *   그런데 이 기사가 진짜로 말하려는 것은 **경계선**이다 —
 *   데이터가 있으면 되는 일과, 한국 번호가 있어야 되는 일 사이의 선.
 *   선을 그리는 데는 그림이 사진보다 낫다.
 *
 * 정직성.
 *   앱과 서비스의 정책은 바뀐다. 여기 적은 것은 2026-08-16 확인 시점의 상태이고
 *   1차 출처가 아니라 취합 자료에 근거한다. 캡션과 맺음말에 그렇게 밝힌다.
 *   확실한 것은 **구조**다 — 한국의 본인확인 제도가 국내 통신사 번호를 요구한다는 것.
 */
interface Props { caption: string }
const { caption } = Astro.props;

const rows = [
  { t: 'Maps, translation, search',        ok: true,  note: 'Naver Map, Papago, Google' },
  { t: 'Messaging and calls over data',    ok: true,  note: 'KakaoTalk, WhatsApp, FaceTime' },
  { t: 'Hailing a taxi',                   ok: true,  note: 'Kakao T works on data with a foreign card', soft: true },
  { t: 'Subway and bus apps',              ok: true,  note: 'Reading times and routes' },
  { t: 'Restaurant and ticket bookings',   ok: false, note: 'Most ask for a Korean number to confirm' },
  { t: 'Korean online shopping',           ok: false, note: 'Coupang and similar block sign-up' },
  { t: 'Food delivery apps',               ok: false, note: 'Baemin, Coupang Eats' },
  { t: 'Anything that sends an SMS code',  ok: false, note: 'A data-only eSIM cannot receive one' },
];

const W = 760, ROW = 46, TOP = 44, L = 34;
const H = TOP + rows.length * ROW + 40;
const GREEN = '#3d6b46', RED = '#b0453a';
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="What a data-only Korean eSIM lets you do and what it does not. Maps, translation, messaging over data, taxi hailing and transit apps all work. Restaurant and ticket bookings, Korean online shopping, food delivery apps and anything requiring an SMS code do not, because a data-only eSIM has no Korean phone number and cannot receive a text message.">

    <text x={L} y={22} font-size="12" font-weight="700" fill="#8a827b" letter-spacing="0.08em">
      DATA-ONLY eSIM · WHAT IT UNLOCKS
    </text>

    {rows.map((r, i) => {
      const y = TOP + i * ROW;
      const c = r.ok ? GREEN : RED;
      return (
        <>
          <rect x={L} y={y} width={W - L - 16} height={ROW - 8} rx="4"
                fill={r.ok ? '#f2f6f2' : '#fbf1f0'} />
          {/* 표시는 색만으로 구분하지 않는다 — 색을 못 보는 독자가 있다 */}
          <text x={L + 16} y={y + 25} font-size="17" font-weight="700" fill={c}>
            {r.ok ? '✓' : '✕'}
          </text>
          <text x={L + 44} y={y + 25} font-size="14.5" font-weight={r.ok ? '400' : '700'}
                fill="#12100f">{r.t}</text>
          <text x={W - 32} y={y + 25} text-anchor="end" font-size="12" fill="#8a827b">
            {r.note}{r.soft ? ' *' : ''}
          </text>
        </>
      );
    })}

    <text x={L} y={H - 14} font-size="11.5" fill="#6b6560">
      * Policies change. Checked 16 August 2026. The line itself does not move: a data-only eSIM has no Korean number.
    </text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; }
  figcaption { margin-top: 0.65rem; font-size: 0.86rem; line-height: 1.55; color: #6b6560; }
</style>
