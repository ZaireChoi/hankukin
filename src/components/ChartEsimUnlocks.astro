---
/**
 * 관광객 eSIM 세 단계 — 데이터만 / 수신만 / 발신까지, 그리고 어디서 벽이 오는가.
 *
 * 2026-08-16 **다시 그렸다.** 첫 판은 전제가 틀렸다.
 *   처음에는 '관광객 eSIM = 데이터 전용, 번호 없음' 이라는 두 칸짜리 그림이었다.
 *   그런데 LG U+ 공식 페이지를 열어 보니 **eSIM 에도 번호가 나온다.**
 *   Data Only 도 수신은 되고, Data+Voice 는 발신까지 된다.
 *
 *   진짜 경계선은 '데이터냐 번호냐' 가 아니라 **'번호냐 본인인증이냐'** 였다.
 *   번호를 받아도 은행·정부 인증은 안 된다 — 그게 통신사 자신의 고지다.
 *   두 칸으로는 그릴 수 없는 그림이라 세 칸으로 다시 그렸다.
 *
 * 근거.
 *   LG U+ Korea eSIM 공식 영문 페이지 (2026-08-16 확인). 사업자 자신의 문서다.
 *   요금과 조건은 그 페이지에 적힌 값을 그대로 옮겼다.
 */
interface Props { caption: string }
const { caption } = Astro.props;

const COLS = [
  { k: 'none',  label: 'No Korean SIM',   sub: 'Roaming or wi-fi only' },
  { k: 'data',  label: 'Data Only eSIM',  sub: 'Online or airport' },
  { k: 'voice', label: 'Data + Voice',    sub: 'Airport counter only' },
];

const ROWS = [
  { t: 'Mobile data in Korea',            none: false, data: true,  voice: true },
  { t: 'A Korean 010 number',             none: false, data: true,  voice: true },
  { t: 'Receiving calls and texts',       none: false, data: true,  voice: true },
  { t: 'Making calls, sending texts',     none: false, data: false, voice: true },
  { t: 'SMS codes for restaurant / taxi', none: false, data: false, voice: true },
  { t: 'Bank and government verification', none: false, data: false, voice: false, wall: true },
];

const W = 760, ROW = 44, TOP = 74, L = 20, LABW = 300;
const H = TOP + ROWS.length * ROW + 46;
const CW = (W - L - LABW - 16) / 3;
const GREEN = '#3d6b46', GREY = '#b8b0a8', RED = '#b0453a';
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="Three levels of Korean mobile service for a visitor. With no Korean SIM you have none of these. A Data Only eSIM gives you data, a Korean 010 number and the ability to receive calls and texts, but not to send them and not to receive verification codes. A Data plus Voice eSIM, sold only at airport counters, adds outgoing calls and texts and SMS verification for restaurant and taxi apps. Bank and government identity verification works on none of them.">

    <text x={L} y={20} font-size="12" font-weight="700" fill="#8a827b" letter-spacing="0.08em">
      WHAT EACH LEVEL ACTUALLY UNLOCKS
    </text>

    {COLS.map((c, i) => {
      const x = L + LABW + i * CW + CW / 2;
      return (
        <>
          <text x={x} y={50} text-anchor="middle" font-size="12.5" font-weight="700" fill="#12100f">{c.label}</text>
          <text x={x} y={65} text-anchor="middle" font-size="10.5" fill="#a09890">{c.sub}</text>
        </>
      );
    })}

    {ROWS.map((r, i) => {
      const y = TOP + i * ROW;
      return (
        <>
          {r.wall && (
            <line x1={L} y1={y - 6} x2={W - 16} y2={y - 6}
                  stroke={RED} stroke-width="1.6" stroke-dasharray="5 4" />
          )}
          <rect x={L} y={y} width={W - L - 16} height={ROW - 8} rx="4"
                fill={r.wall ? '#fbf1f0' : (i % 2 ? '#faf8f5' : '#fff')} />
          <text x={L + 14} y={y + 24} font-size="13.5"
                font-weight={r.wall ? '700' : '400'} fill="#12100f">{r.t}</text>
          {['none', 'data', 'voice'].map((k, j) => {
            const on = r[k];
            const x = L + LABW + j * CW + CW / 2;
            return (
              /* 색만으로 구분하지 않는다 — 기호를 함께 쓴다 */
              <text x={x} y={y + 25} text-anchor="middle" font-size="16" font-weight="700"
                    fill={on ? GREEN : (r.wall ? RED : GREY)}>{on ? '✓' : '✕'}</text>
            );
          })}
        </>
      );
    })}

    <text x={L} y={H - 14} font-size="11.5" fill="#6b6560">
      Per LG U+'s own English product notice, checked 16 August 2026. The last row is the one nobody warns you about.
    </text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; }
  figcaption { margin-top: 0.65rem; font-size: 0.86rem; line-height: 1.55; color: #6b6560; }
</style>
