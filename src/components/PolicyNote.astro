---
/**
 * 번역된 정책 페이지 하단에 붙는 한 줄.
 *
 * 왜 필요한가 (2026-08-16).
 *   개인정보 처리방침과 제휴 고지는 **읽는 사람의 권리에 관한 문서**다.
 *   그걸 원어민 교정 없이 AI 번역으로 내놓으면서 아무 말도 하지 않으면,
 *   번역 오차가 곧 「우리가 그렇게 약속했다」가 된다.
 *   그래서 구속력의 기준이 영어판임을 그 언어로 적는다.
 *
 *   영어판에는 아무것도 붙지 않는다 — 영어판이 원문이기 때문이다.
 */
import { POLICY_NOTE } from '../config/policy.mjs';
interface Props { lang: string }
const { lang } = Astro.props;
const note = POLICY_NOTE[lang];
---
{note && <p class="pnote">{note}</p>}

<style>
  .pnote {
    margin: 2.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid #ece3d7;
    font-size: .82rem;
    line-height: 1.7;
    color: #6b6560;
  }
</style>
