---
/**
 * 만 단위 대조도 — 같은 자릿수 위에 세 자리 묶음과 네 자리 묶음을 겹쳐 놓는다.
 *
 * 왜 그렸나 (2026-08-19, Decode 5편).
 *   이 기사가 다루는 것은 **읽는 사람이 아는 그 숫자가 맞는데 끊는 자리가 다르다**는 사실이다.
 *   표로 쓰면 「35,000 = 삼만 오천」이라는 결과만 남고, 왜 그렇게 되는지가 안 보인다.
 *   요점은 결과가 아니라 **쉼표와 만이 어긋나 있는 그 한 칸**이다.
 *
 *   방(房)편 ChartBangFamily 는 등식(=) 구도,
 *   로마자편 ChartSignSpellsSound 는 2행 대조 구도였다.
 *   이 그림은 **같은 한 줄 위에 두 개의 눈금**이라 위·아래 괄호 구도로 간다.
 *
 * 숫자는 한글 맞춤법 제44항에 실제로 실린 예(12억 3456만 7898)를 그대로 쓴다.
 * 우리가 만든 숫자를 쓰면 이 그림이 증거가 아니라 주장이 된다.
 *
 * 2026-08-19 두 번째 판. 첫 판은 행 이름을 괄호 **아래**에 놓았더니
 * 억·만 설명줄과 겹쳐서 세 줄이 한 덩어리로 읽혔다 — PNG 로 뽑아 보고 알았다.
 * 왼쪽에 이름 자리를 따로 내고 숫자 줄을 오른쪽으로 밀었다.
 */
interface Props { caption: string }
const { caption } = Astro.props;

const W = 760, H = 352;

/* 제44항의 예: 십이억 삼천사백오십육만 칠천팔백구십팔 */
const DIGITS = ['1', '2', '3', '4', '5', '6', '7', '8', '9', '8'];

const LX = 24;                        // 행 이름 자리
const X0 = 186, CW = 55, CH = 58;     // 숫자 칸
const DY = 140;
const cx = (i: number) => X0 + i * CW + CW / 2;
const gx = (a: number, b: number) => [X0 + a * CW, X0 + (b + 1) * CW] as const;

const MUTED = '#8a827b';
const INK = '#12100f';
const LINE = '#b8ada0';
const ACCENT = '#c9622e';

/* 위 — 영어식 세 자리: 1 | 234 | 567 | 898 */
const EN = [
  { a: 0, b: 0, label: 'billion' },
  { a: 1, b: 3, label: 'million' },
  { a: 4, b: 6, label: 'thousand' },
];
/* 아래 — 한국어식 네 자리: 12 | 3456 | 7898 */
const KO = [
  { a: 0, b: 1, label: '억', sub: 'eok · 100 million' },
  { a: 2, b: 5, label: '만', sub: 'man · 10 thousand' },
];

const EN_BAR = 96, KO_BAR = 232;
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="The ten-digit number 1234567898 written once, with two different sets of grouping marks. Above it, English cuts the digits into groups of three, giving one billion, two hundred thirty-four million, five hundred sixty-seven thousand, eight hundred ninety-eight. Below it, Korean cuts the same digits into groups of four, giving 12 eok, 3456 man, 7898. The two sets of cut marks never line up.">

    <text x={LX} y="30" font-size="12" font-weight="700" fill={MUTED} letter-spacing="0.08em">
      ONE NUMBER, TWO PLACES TO CUT IT
    </text>

    {/* ── 위: 영어식 세 자리 ── */}
    <text x={LX} y={EN_BAR + 8} font-size="12.5" font-weight="700" fill={MUTED}>ENGLISH CUTS</text>
    <text x={LX} y={EN_BAR + 25} font-size="12.5" font-weight="700" fill={MUTED}>EVERY 3 DIGITS</text>

    {EN.map(({ a, b, label }) => {
      const [x1, x2] = gx(a, b);
      return (
        <g>
          <path d={`M ${x1 + 4} ${DY - 6} V ${EN_BAR} H ${x2 - 4} V ${DY - 6}`}
                fill="none" stroke={LINE} stroke-width="1.6" />
          <text x={(x1 + x2) / 2} y={EN_BAR - 10} text-anchor="middle" font-size="14" fill="#6b6560">{label}</text>
        </g>
      );
    })}

    {/* ── 숫자 한 줄 ── */}
    {DIGITS.map((d, i) => (
      <g>
        <rect x={X0 + i * CW} y={DY} width={CW} height={CH} fill="#fffdfa" stroke="#e0d8ce" />
        <text x={cx(i)} y={DY + 41} text-anchor="middle" font-size="30" font-weight="700" fill={INK}>{d}</text>
      </g>
    ))}

    {/* ── 아래: 한국어식 네 자리 ── */}
    <text x={LX} y={KO_BAR + 6} font-size="12.5" font-weight="700" fill={ACCENT}>KOREAN CUTS</text>
    <text x={LX} y={KO_BAR + 23} font-size="12.5" font-weight="700" fill={ACCENT}>EVERY 4 DIGITS</text>

    {KO.map(({ a, b, label, sub }) => {
      const [x1, x2] = gx(a, b);
      return (
        <g>
          <path d={`M ${x1 + 4} ${DY + CH + 6} V ${KO_BAR} H ${x2 - 4} V ${DY + CH + 6}`}
                fill="none" stroke={ACCENT} stroke-width="1.8" />
          <text x={(x1 + x2) / 2} y={KO_BAR + 30} text-anchor="middle" font-size="22" font-weight="700" fill={ACCENT}>{label}</text>
          <text x={(x1 + x2) / 2} y={KO_BAR + 49} text-anchor="middle" font-size="12" fill="#6b6560">{sub}</text>
        </g>
      );
    })}

    <text x={LX} y="318" font-size="13" fill="#3c3733">
      Read aloud, the same ten digits come out as 12억 3456만 7898 — the cut marks above and below
    </text>
    <text x={LX} y="336" font-size="13" fill="#3c3733">
      never once land in the same place. That mismatch is the whole difficulty.
    </text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; }
  figcaption { margin-top: 0.65rem; font-size: 0.86rem; line-height: 1.55; color: #6b6560; }
</style>
