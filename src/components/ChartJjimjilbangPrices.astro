---
/**
 * 「찜질방」이라는 한 단어가 덮는 값의 폭.
 *
 * 왜 그렸나 (2026-08-22).
 *   재고 54곳에 목욕·찜질 사진이 **한 장도 없다.** 그런데 이 도표는 사진의 대타가 아니다.
 *   영어 가이드는 전부 "jjimjilbang: ₩10,000–20,000" 이라고 쓰는데, 출처가 없고 폭도 틀렸다.
 *   실제로는 정부 조사의 목욕료 8,308원부터 리조트 스파의 58,000원까지가 같은 낱말로 불린다.
 *   **일곱 배다.** 그 사실은 문장보다 눈금 위에서 빨리 보인다.
 *
 *   숫자의 출처가 둘로 갈린다. 한 칸에 섞어 놓으면 그게 안 보이므로 막대마다 출처를 적었다.
 *     8,308 / 11,000     한국소비자원 참가격 「목욕료」 (2026년 6월분, 2026-08-14 확인)
 *     26,000 / 48,000 / 58,000  아쿠아필드 공식 이용안내 (2026-08-22 확인)
 *
 *   ※ 참가격에는 **찜질방 항목이 없다.** 조사 품목은 세탁·숙박·이용·미용·목욕뿐이다.
 *     그래서 「목욕료」와 「찜질스파」는 같은 자에 놓았을 뿐 같은 물건이 아니다 —
 *     도표에서 색과 출처로 갈라 놓은 이유가 그것이다.
 */
interface Props { lang?: string; caption?: string }
const { lang = 'en', caption } = Astro.props;

const W = 760, H = 330;
const X0 = 230;                    // 0원의 x
const PX = (700 - X0) / 60000;     // 원당 픽셀 (60,000원이 오른쪽 끝)
const x = (won) => X0 + won * PX;
const ROW0 = 78, ROW = 42;

/** 값은 언어와 무관하다. 한 곳에만 적는다. */
const BARS = [
  { won:  8308, kind: 'gov' },
  { won: 11000, kind: 'gov' },
  { won: 26000, kind: 'op'  },
  { won: 48000, kind: 'op'  },
  { won: 58000, kind: 'op'  },
];

const T = {
  en: {
    kicker: 'ONE WORD, SEVEN TIMES THE PRICE',
    sub: 'What ₩8,308 and ₩58,000 are both called in English: “a jjimjilbang”.',
    names: [
      'Public bath, cheapest region',
      'Public bath, Seoul',
      'Resort sweat-spa',
      'Resort water park',
      'Both, one ticket',
    ],
    srcs: ['government survey', 'government survey', "operator's own page", "operator's own page", "operator's own page"],
    legend: ['Korea Consumer Agency, “목욕료”, June 2026', 'Aquafield, published rates, 22 Aug 2026'],
    note: 'The government survey has no line for a jjimjilbang at all. Its items are laundry, lodging, barber, salon and bath.',
    alt: 'Price ladder for Korean bathing places. A public bath is ₩8,308 in the cheapest region and ₩11,000 in Seoul, from the Korea Consumer Agency survey for June 2026. At a resort operator, the sweat-spa ticket is ₩26,000, the water park ₩48,000, and a combined pass ₩58,000, from the operator’s own published rates. English guides describe all of these with the single word jjimjilbang.',
  },
};
const t = T[lang] ?? T.en;

const won = (n) => '₩' + n.toLocaleString('en-US');
const rows = BARS.map((b, i) => ({
  ...b, name: t.names[i], src: t.srcs[i], y: ROW0 + i * ROW, x2: x(b.won),
  tone: b.kind === 'gov' ? '#1f7a4d' : '#c9622e',
}));
const ticks = [0, 20000, 40000, 60000];
---

<figure class="chart">
<svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" role="img" aria-label={t.alt}>
  <text x="30" y="26" font-size="12" font-weight="700" fill="#8a827b" letter-spacing="0.08em">{t.kicker}</text>
  <text x="30" y="47" font-size="12.5" fill="#3c3733">{t.sub}</text>

  {ticks.map((v) => (
    <>
      <line x1={x(v).toFixed(1)} y1="60" x2={x(v).toFixed(1)} y2={(ROW0 + 5 * ROW - 24).toFixed(1)} stroke="#efe9e1" />
      <text x={x(v).toFixed(1)} y={(ROW0 + 5 * ROW - 8).toFixed(1)} text-anchor="middle" font-size="11" fill="#8a827b">
        {v === 0 ? '0' : (v / 10000) + '만'}
      </text>
    </>
  ))}

  {rows.map((r) => (
    <>
      <text x={(X0 - 14).toFixed(1)} y={(r.y + 4).toFixed(1)} text-anchor="end" font-size="12.5" fill="#12100f">{r.name}</text>
      <rect x={X0} y={(r.y - 9).toFixed(1)} width={(r.x2 - X0).toFixed(1)} height="18" rx="3" fill={r.tone} opacity="0.85" />
      <text x={(r.x2 + 10).toFixed(1)} y={(r.y + 4).toFixed(1)} font-size="12" font-weight="700" fill={r.tone}>{won(r.won)}</text>
      <text x={(X0 - 14).toFixed(1)} y={(r.y + 18).toFixed(1)} text-anchor="end" font-size="10" fill="#a09890">{r.src}</text>
    </>
  ))}

  <circle cx="34" cy={H - 42} r="5" fill="#1f7a4d" />
  <text x="46" y={H - 38} font-size="11.5" fill="#6b6560">{t.legend[0]}</text>
  <circle cx="34" cy={H - 24} r="5" fill="#c9622e" />
  <text x="46" y={H - 20} font-size="11.5" fill="#6b6560">{t.legend[1]}</text>
  <text x="30" y={H - 4} font-size="11" fill="#a09890">{t.note}</text>
</svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; }
  .chart figcaption {
    font-size: 0.85rem; line-height: 1.5; color: var(--suggested);
    margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px solid var(--line);
  }
</style>
