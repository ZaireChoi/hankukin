---
/**
 * 폭싹 속았수다 — 같은 글자, 두 개의 사전.
 *
 * 왜 그렸나 (2026-09-05, Decode 10편).
 *   제주 사진은 제주 1편이 이미 쓰고 있고(no-shared-images), 말 이야기에 풍경을 붙이면
 *   「그냥 한국」 사진이 된다. 그리고 이 글의 요점은 한 장의 그림이다 —
 *   **같은 다섯 글자를 육지 사전으로 읽으면 한 문장, 제주 사전으로 읽으면 다른 문장.**
 *   문장으로 쓰면 「오해할 수 있다」로 흘러가고, 두 열로 놓으면 독자가 직접 대조한다.
 *
 *   ChartSpeechLevels 는 사다리, ChartBangFamily 는 등식이었다. 이번엔 **두 열 대조**다.
 *
 * 왼쪽 열은 국립국어원 표준국어대사전(속다 · 폭삭)이고,
 * 오른쪽 열은 제주학연구센터 제주어대사전 「제주어왓」(속다 02 · 복삭 04)과
 * 디지털제주문화대전 「제주방언」(서체 어미 -수다)이다. 전부 2026-09-05 에 열어서 옮겼다.
 * '폭싹' 이 제주어왓에 표제어로 없다는 것도 같은 날 검색해서 본 결과다(0건).
 * 추측으로 채운 칸은 없다.
 */
interface Props { caption: string }
const { caption } = Astro.props;

const W = 760, H = 470;

const ACCENT = '#c9622e';
const INK = '#12100f';
const MUTED = '#8a827b';
const BODY = '#3c3733';

// 열
const C0 = 40,  C0W = 120;   // 글자
const C1 = 178, C1W = 262;   // 육지 사전
const C2 = 458, C2W = 262;   // 제주 사전

const RH = 92;
const TOP = 96;

const rows = [
  {
    ko: '폭싹', rom: 'pok-ssak',
    main: ['Read as 폭삭 pok-sak.', 'Eight senses: collapse, rot,', 'ruin, aged. None means "very".'],
    jeju: ['Not a headword. The Jeju word', 'is 복삭 bok-sak — sense 04:', '"very hard; extremely."'],
  },
  {
    ko: '속았', rom: 'sog-at',
    main: ['속다 sok-da: to be taken in', 'by a lie or trick; to mistake one', 'thing for another. Both = fooled.'],
    jeju: ['속다 02: to put strength and', 'effort into work. Standard', 'gloss: 수고하다, to take pains.'],
  },
  {
    ko: '-수다', rom: 'su-da',
    main: ['Not on the six-rung ladder', 'of standard endings. Sounds like', 'a clipped -습니다 seum-ni-da.'],
    jeju: ['The polite level, 서체 seo-che.', '밥 먹엄수다 — "I am eating,"', 'said respectfully.'],
  },
];

const RES_Y = TOP + rows.length * RH + 14;
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="The title 폭싹 속았수다 split into three pieces and read against two dictionaries. Under the Standard Korean Dictionary, 폭싹 is read as 폭삭 with eight senses of collapse, rot, ruin and ageing and none meaning very; 속다 has two senses, to be taken in by a lie or trick and to mistake one thing for another, both about being fooled; and -수다 is not a standard ending. Under the Jeju dictionary of the Center for Jeju Studies, 폭싹 is not a headword and the Jeju word is 복삭, sense four, very hard or extremely; 속다 sense two is to put strength and effort into work, glossed as sugohada, to take pains; and -수다 is the polite speech level called seoche. The mainland reading adds up to You were utterly taken in. The Jeju reading adds up to You have worked so very hard.">

    <text x={C0} y="26" font-size="12" font-weight="700" fill={MUTED} letter-spacing="0.08em">
      FIVE SYLLABLES. TWO DICTIONARIES.
    </text>

    {/* 열 머리 */}
    <text x={C1} y="60" font-size="12.5" font-weight="700" fill={INK}>Mainland reading</text>
    <text x={C1} y="76" font-size="10.5" fill={MUTED}>표준국어대사전 · Standard Korean Dictionary, NIKL</text>
    <text x={C2} y="60" font-size="12.5" font-weight="700" fill={ACCENT}>Jeju reading</text>
    <text x={C2} y="76" font-size="10.5" fill={MUTED}>제주어대사전 · Center for Jeju Studies</text>

    {rows.map((r, i) => {
      const y = TOP + i * RH;
      return (
        <>
          <rect x={C0} y={y} width={C2 + C2W - C0} height={RH - 10} rx="4" fill="#fffdfa" stroke="#e0d8ce" />
          <rect x={C2 - 10} y={y} width={C2W + 10} height={RH - 10} rx="4" fill="#fbf3ec" stroke="none" />
          <rect x={C2 - 10} y={y} width="3.5" height={RH - 10} rx="1.6" fill={ACCENT} />

          <text x={C0 + 14} y={y + 38} font-size="26" font-weight="700" fill={INK}>{r.ko}</text>
          <text x={C0 + 14} y={y + 58} font-size="10.5" fill={MUTED}>{r.rom}</text>

          {r.main.map((line, j) => (
            <text x={C1} y={y + 30 + j * 17} font-size="12" fill={BODY}>{line}</text>
          ))}
          {r.jeju.map((line, j) => (
            <text x={C2} y={y + 30 + j * 17} font-size="12" fill={j === 0 ? INK : BODY} font-weight={j === 0 ? '700' : '400'}>{line}</text>
          ))}
        </>
      );
    })}

    {/* 합계 */}
    <line x1={C0} y1={RES_Y - 6} x2={C2 + C2W} y2={RES_Y - 6} stroke="#e0d8ce" />
    <text x={C0 + 14} y={RES_Y + 20} font-size="11" font-weight="700" fill={MUTED} letter-spacing="0.06em">ADDS UP TO</text>
    <text x={C1} y={RES_Y + 21} font-size="13" fill={BODY}>“You were utterly taken in.”</text>
    <text x={C2} y={RES_Y + 21} font-size="13" font-weight="700" fill={ACCENT}>“You have worked so very hard.”</text>

    <text x={C0} y={H - 26} font-size="11.5" fill={MUTED}>
      Our own illustration. Left column: 표준국어대사전 (속다, 폭삭). Right column: 제주어왓 (속다 02, 복삭 04)
    </text>
    <text x={C0} y={H - 11} font-size="11.5" fill={MUTED}>
      and 디지털제주문화대전 「제주방언」 for the -수다 level. All opened 5 September 2026.
    </text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; border: 1px solid #e0d8ce; border-radius: 6px; background: #fffdfa; }
  .chart figcaption { margin-top: .6rem; font-size: .9rem; color: #6b6560; line-height: 1.5; }
</style>
