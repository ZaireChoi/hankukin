---
/**
 * 지도 링크 — 그리고 택시 기사에게 보여줄 한 줄.
 *
 * 왜 (2026-08-16 외부 평가 2순위):
 *   "경주 기사조차 지도 링크가 없어서 KPI 인 '지도 실행률' 을 측정할 수 없다."
 *   맞는 지적이고, 구현 난이도 대비 효과가 가장 큰 항목이라는 판단에도 동의한다.
 *
 * 그런데 이걸 만들면서 한 가지를 더 깨달았다.
 *
 *   영어권 여행 사이트는 지도 링크를 **구글 지도**로 건다.
 *   그런데 **한국에서 구글 지도는 길찾기가 제대로 안 된다.** 국내 지도 반출 규제 때문에
 *   도보·대중교통 안내가 반쪽이고, 현지인은 아무도 그걸 쓰지 않는다.
 *   카카오맵과 네이버지도를 먼저 놓는 것이 맞다. 구글은 셋째다.
 *
 *   이건 한국에 살아 본 사람만 아는 것이고, 정확히 이 사이트가 존재하는 이유다.
 *   지도 링크 하나에도 그 차이가 드러나야 한다.
 *
 * 좌표를 쓰지 않고 **한국어 이름으로 검색**을 건다.
 *   ① 좌표는 틀리면 조용히 틀린다. 이름은 틀리면 눈에 보인다.
 *   ② 한국어 이름 자체가 독자에게 쓸모가 있다 —
 *      택시에서 보여 주면 그만이다. 그래서 이름을 **화면에도 크게 띄운다.**
 *      지도 앱을 안 열어도 이 블록은 일한다.
 */
interface Props {
  /** 한국어 이름. 지도 앱이 찾는 이름 그대로. */
  ko: string;
  /** 영어 표기 */
  en: string;
  /** 한 줄 설명 (선택) */
  note?: string;
}
const { ko, en, note } = Astro.props;
const q = encodeURIComponent(ko);

const maps = [
  { label: 'KakaoMap',    href: `https://map.kakao.com/?q=${q}`,                        best: true  },
  { label: 'Naver Map',   href: `https://map.naver.com/p/search/${q}`,                  best: true  },
  { label: 'Google Maps', href: `https://www.google.com/maps/search/?api=1&query=${q}`, best: false },
];
---

<aside class="maplinks">
  <p class="en">{en}</p>
  {/* 한국어 이름이 주인공이다. 이걸 보여 주는 것이 이 블록의 첫 번째 일이다. */}
  <p class="ko" lang="ko">{ko}</p>
  {note && <p class="note">{note}</p>}

  <p class="show">Show this line to a taxi driver — it is the name every Korean map uses.</p>

  <div class="links">
    {maps.map((m) => (
      <a href={m.href} rel="noopener" target="_blank" class={m.best ? 'best' : ''}>
        {m.label}{m.best && <span class="tick">works properly here</span>}
      </a>
    ))}
  </div>
</aside>

<style>
  .maplinks {
    margin: 1.8rem 0;
    padding: 1rem 1.15rem;
    border: 1px solid #e0d8ce;
    border-radius: 6px;
    background: #fffdfa;
  }
  .en { margin: 0 0 0.15rem; font-size: 0.79rem; letter-spacing: 0.05em;
        text-transform: uppercase; color: #a09890; font-weight: 700; }
  .ko {
    margin: 0 0 0.4rem;
    font-family: 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif;
    font-size: 1.42rem; font-weight: 700; color: #12100f;
    word-break: keep-all;
    user-select: all;          /* 한 번 눌러 통째로 선택되게 — 복사해 쓰라는 뜻이다 */
  }
  .note { margin: 0 0 0.5rem; font-size: 0.88rem; color: #4a443f; line-height: 1.6; }
  .show { margin: 0 0 0.8rem; font-size: 0.76rem; color: #8a827b; font-style: italic; }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .links a {
    display: inline-flex; align-items: baseline; gap: 0.4rem;
    padding: 0.42rem 0.75rem; border: 1px solid #e0d8ce; border-radius: 4px;
    font-size: 0.85rem; color: #4a443f; text-decoration: none; background: #fff;
  }
  .links a.best { border-color: #c9622e; color: #c9622e; font-weight: 600; }
  .links a:hover { background: #fbf7f1; }
  .tick { font-size: 0.68rem; font-weight: 400; color: #a3714f; }
</style>
