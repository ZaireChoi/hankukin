---
/**
 * 상대경어법 6등급 사다리 — 살아 있는 칸과 비어 있는 칸.
 *
 * 왜 그렸나 (2026-08-18, Decode 4편).
 *   말투 이야기라 사진이 있을 수가 없다. 재고 139장 중 미사용분을 훑었지만
 *   전부 궁궐·역·거리다. 붙이면 주제와 무관한 「그냥 한국」 사진이 된다.
 *
 *   그리고 이 기사의 요점은 **여섯 칸 중 둘이 사실상 비어 있다**는 것이다.
 *   그건 문장으로 쓰면 흘러가고 표로 그리면 한눈에 보인다 —
 *   비어 있는 칸을 실제로 회색으로 칠하면 독자가 세지 않아도 안다.
 *
 *   ChartBangFamily 는 등식(=), ChartClinicSignFormula 는 해부도였다.
 *   같은 모양을 세 번 그리지 않으려고 이번엔 **사다리**로 갔다.
 *
 * 등급·어미·현재 쓰임은 전부 「공손법」(한국민족문화대백과사전, 이래호, 2017)에서 왔다.
 * 하오체·하게체가 장년층 이상에 한정된다는 것은 「경어」(안병희, 1995) 쪽 서술이다.
 * 추측으로 채운 칸은 없다 — 사극 이야기를 넣고 싶었지만 출처가 없어 뺐다.
 */
interface Props { caption: string }
const { caption } = Astro.props;

const W = 760, H = 414;

const ACCENT = '#c9622e';
const INK = '#12100f';
const MUTED = '#8a827b';
const BODY = '#3c3733';

// 열 — 오른쪽 끝이 720 을 넘지 않게 잡았다
const C1 = 40,  C1W = 190;   // 등급 이름
const C2 = 238, C2W = 180;   // 어미
const C3 = 426, C3W = 210;   // 하는 일
const C4 = 646, C4W = 74;    // 상태

const RH = 46;               // 행 높이

const formal = [
  { ko: '하십시오체', rom: 'ha-sip-si-o-che', end: '-습니다 · -십시오', does: 'Upward only. Not to equals.', live: true },
  { ko: '하오체',     rom: 'ha-o-che',        end: '-오 · -소 · -구려',  does: 'Older speakers.',            live: false },
  { ko: '하게체',     rom: 'ha-ge-che',       end: '-게 · -나 · -세',    does: 'Down, not dismissive. 자네.', live: false },
  { ko: '해라체',     rom: 'hae-ra-che',      end: '-아라 · -느냐 · -자', does: 'Juniors, close friends.',    live: true },
];

const everyday = [
  { ko: '해요체', rom: 'hae-yo-che', end: '-요', does: 'Up, across or down. Most used.', live: true },
  { ko: '해체',   rom: 'hae-che',    end: '-아/-어 · -지',  does: 'Close friends — or an insult.', live: true, tag: '= 반말' },
];

const G1Y = 62;                       // 격식체 첫 행
const G2Y = G1Y + formal.length * RH + 42;   // 비격식체 첫 행
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="The six levels of Korean listener honorifics. The formal set has four: hasipsioche, ending in -seumnida and -sipsio, used only upward; haoche, ending in -o, -so and -guryeo, now confined to older speakers; hageche, ending in -ge, -na and -se, also confined to older speakers; and haerache, ending in -ara, -neunya and -ja, used to juniors and close friends. The everyday set has two: haeyoche, formed by adding -yo, usable up, across or down and the most used level today; and haeche, ending in -a or -eo and -ji, which is the level called banmal and can mean closeness or contempt. Two of the six, haoche and hageche, are shaded to show they have dropped out of ordinary speech.">

    <text x={C1} y="24" font-size="12" font-weight="700" fill={MUTED} letter-spacing="0.08em">
      SIX RUNGS. TWO OF THEM ARE EMPTY.
    </text>

    {/* ── 격식체 ─────────────────────────────── */}
    <text x={C1} y={G1Y - 12} font-size="12.5" font-weight="700" fill={INK}>
      격식체 <tspan fill={MUTED} font-weight="400">gyeok-sik-che — the formal set: distance, ceremony, strangers</tspan>
    </text>

    {formal.map((r, i) => {
      const y = G1Y + i * RH;
      return (
        <>
          <rect x={C1} y={y} width={C4 + C4W - C1} height={RH - 6} rx="4"
                fill={r.live ? '#fffdfa' : '#efeae3'}
                stroke={r.live ? '#e0d8ce' : '#e0d8ce'} />
          {r.live && <rect x={C1} y={y} width="3.5" height={RH - 6} rx="1.6" fill={ACCENT} />}
          <text x={C1 + 14} y={y + 20} font-size="18" font-weight="700" fill={r.live ? INK : '#9a938c'}>{r.ko}</text>
          <text x={C1 + 14} y={y + 34} font-size="10.5" fill={MUTED}>{r.rom}</text>
          <text x={C2} y={y + 26} font-size="14.5" fill={r.live ? BODY : '#9a938c'}>{r.end}</text>
          <text x={C3} y={y + 26} font-size="11.5" fill={r.live ? BODY : '#9a938c'}>{r.does}</text>
          <text x={C4 + C4W - 14} y={y + 26} text-anchor="end" font-size="10" font-weight="700"
                letter-spacing="0.06em" fill={r.live ? ACCENT : '#a8a099'}>
            {r.live ? 'EVERYDAY' : 'RARE'}
          </text>
        </>
      );
    })}

    {/* ── 비격식체 ───────────────────────────── */}
    <text x={C1} y={G2Y - 12} font-size="12.5" font-weight="700" fill={INK}>
      비격식체 <tspan fill={MUTED} font-weight="400">bi-gyeok-sik-che — the everyday set: closeness, or its absence</tspan>
    </text>

    {everyday.map((r, i) => {
      const y = G2Y + i * RH;
      return (
        <>
          <rect x={C1} y={y} width={C4 + C4W - C1} height={RH - 6} rx="4"
                fill="#fffdfa" stroke="#e0d8ce" />
          <rect x={C1} y={y} width="3.5" height={RH - 6} rx="1.6" fill={ACCENT} />
          <text x={C1 + 14} y={y + 20} font-size="18" font-weight="700" fill={INK}>
            {r.ko}{r.tag && <tspan font-size="11.5" font-weight="700" fill={ACCENT} dx="7">{r.tag}</tspan>}
          </text>
          <text x={C1 + 14} y={y + 34} font-size="10.5" fill={MUTED}>{r.rom}</text>
          <text x={C2} y={y + 26} font-size="14.5" fill={BODY}>{r.end}</text>
          <text x={C3} y={y + 26} font-size="11.5" fill={BODY}>{r.does}</text>
          <text x={C4 + C4W - 14} y={y + 26} text-anchor="end" font-size="10" font-weight="700"
                letter-spacing="0.06em" fill={ACCENT}>EVERYDAY</text>
        </>
      );
    })}

    {/*
      2026-08-18. 여기에 「비어 있는 두 칸이 무슨 뜻인가」를 적었다가 지웠다.
      figcaption 이 이미 그 말을 하고 있었다 — 8/17 에 세 번 걸린 것과 같은 실수다.
      도표 각주는 **출처만** 말한다. 뜻은 캡션이 말한다.
    */}
    <text x={C1} y={H - 26} font-size="11.5" fill={MUTED}>
      Our own illustration. The levels, their endings, and the note on who still uses 하오체 and 하게체
    </text>
    <text x={C1} y={H - 11} font-size="11.5" fill={MUTED}>
      are from 「공손법」 and 「경어」, Encyclopedia of Korean Culture, Academy of Korean Studies.
    </text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; border: 1px solid #e0d8ce; border-radius: 6px; background: #fffdfa; }
  .chart figcaption { margin-top: .6rem; font-size: .9rem; color: #6b6560; line-height: 1.5; }
</style>
