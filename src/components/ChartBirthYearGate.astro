---
/**
 * 출생연도 관문 — 생일이 아니라 1월 1일에 문이 열리는 것을 세 사람으로 보여준다.
 *
 * 왜 그렸나 (2026-08-27, Decode 8편).
 *   이 기사의 요점은 「한국 음주 가능 나이는 19세」라는 영어권 통설이
 *   **가장자리에서 틀린다**는 것이다. 문장으로 쓰면 「연 나이 기준」이라는
 *   결과만 남고, 하루 차이가 일 년 차이가 되는 그 지점이 안 보인다.
 *   2007-12-31 생과 2008-01-01 생은 생일이 하루 차이인데
 *   술을 살 수 있게 되는 날은 정확히 365일 차이다. 그 간격이 이 그림의 주인공이다.
 *
 * 날짜는 청소년 보호법 제2조 제1호의 규칙(19세가 되는 해의 1월 1일)에서
 * 우리가 도출했다. 세 생일 자체는 예시다 — 그림 하단에 그렇게 적었다.
 *
 * 숫자편 ChartManGrouping 은 한 줄 위 두 눈금, 문패편 ChartDoorSigns 는
 * 팻말 나열 구도였다. 이 그림은 **세 줄 타임라인 + 세로 관문선** 구도로 간다.
 */
interface Props { caption: string }
const { caption } = Astro.props;

const W = 760, H = 408;

const INK = '#12100f';
const MUTED = '#6b6560';
const FAINT = '#a09890';
const LINE = '#b8ada0';
const ACCENT = '#c9622e';

/* 타임라인: 2025-10 (m=0) → 2027-04 (m=18) */
const X0 = 196, XE = 738;
const px = (m: number) => X0 + (m * (XE - X0)) / 18;

const JAN26 = px(3);      // 2026-01-01
const MAR26 = px(5);      // 2026-03-01
const DEC26 = px(15);     // 2026-12-31 ≈ 2027-01-01
const JAN27 = px(15);

const rows = [
  { y: 128, born: 'Born 1 Mar 2007',  bday: MAR26, bdayLabel: '19 on 1 Mar 2026', open: JAN26 },
  { y: 218, born: 'Born 31 Dec 2007', bday: DEC26, bdayLabel: '19 on 31 Dec 2026', open: JAN26 },
  { y: 308, born: 'Born 1 Jan 2008',  bday: JAN27, bdayLabel: '19 on 1 Jan 2027', open: JAN27 },
];
---
<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" role="img"
       aria-label="Timeline for three people born on 1 March 2007, 31 December 2007 and 1 January 2008. The first two may be sold alcohol from 1 January 2026; the third only from 1 January 2027, despite being born one day after the second.">
    <rect width={W} height={H} fill="#fffdfa" />

    {/* 관문선 두 개 */}
    <path d={`M ${JAN26} 56 V 340`} stroke={ACCENT} stroke-width="1.5" stroke-dasharray="5 4" />
    <text x={JAN26} y="46" text-anchor="middle" font-size="13" font-weight="700" fill={ACCENT}>1 Jan 2026</text>
    <path d={`M ${JAN27} 56 V 340`} stroke={ACCENT} stroke-width="1.5" stroke-dasharray="5 4" />
    <text x={JAN27} y="46" text-anchor="middle" font-size="13" font-weight="700" fill={ACCENT}>1 Jan 2027</text>

    {rows.map((r) => (
      <>
        <text x="24" y={r.y - 24} font-size="14" font-weight="700" fill={INK}>{r.born}</text>

        {/* 기준선 */}
        <path d={`M ${X0} ${r.y} H ${XE}`} stroke={LINE} stroke-width="1.5" />

        {/* 살 수 있는 구간 */}
        <rect x={r.open} y={r.y - 5} width={XE - r.open} height="10" rx="5" fill={ACCENT} opacity="0.9" />

        {/* 만 19세 생일 */}
        <circle cx={r.bday} cy={r.y} r="7" fill="#fffdfa" stroke={INK} stroke-width="2.5" />
        <text x={r.bday} y={r.y + 26} text-anchor="middle" font-size="11.5" fill={MUTED}>{r.bdayLabel}</text>
      </>
    ))}

    {/* 주석 — 둘째 줄: 생일보다 364일 먼저 */}
    <path d={`M ${JAN26 + 6} ${rows[1].y - 20} H ${DEC26 - 12}`} stroke={MUTED} stroke-width="1" />
    <text x={(JAN26 + DEC26) / 2} y={rows[1].y - 27} text-anchor="middle" font-size="11.5" fill={MUTED}>
      may buy for 364 days before turning 19
    </text>

    {/* 주석 — 셋째 줄: 하루 늦게 태어나 일 년을 더 기다린다 */}
    <text x={X0 + 10} y={rows[2].y - 16} font-size="11.5" fill={MUTED}>
      born one day after the person above — the door opens a year later
    </text>

    {/* 범례 */}
    <rect x="24" y="358" width="26" height="10" rx="5" fill={ACCENT} opacity="0.9" />
    <text x="58" y="367" font-size="12" fill={MUTED}>may legally be sold alcohol and tobacco</text>
    <circle cx="330" cy="363" r="7" fill="#fffdfa" stroke={INK} stroke-width="2.5" />
    <text x="344" y="367" font-size="12" fill={MUTED}>19th birthday, international age</text>

    <text x="24" y={H - 12} font-size="11.5" fill={FAINT}>
      Our own illustration. Birthdays are examples; opening dates follow article 2(1) of the Youth Protection Act.
    </text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; }
  figcaption { margin-top: 0.65rem; font-size: 0.86rem; line-height: 1.55; color: #6b6560; }
</style>
