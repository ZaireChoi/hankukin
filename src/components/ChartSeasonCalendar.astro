---
/**
 * 한국 계절 캘린더 — 1월부터 12월까지 한 화면.
 *
 * 왜 만들었나 (2026-08-15 운영자 지적).
 *   "계절을 즐기기 위한 개략적인 캘린더 데이가 없네."
 *   맞는 지적이었다. 계절 기사 네 편이 전부 "정확한 날짜는 못 준다" 고만 하고
 *   **대략적인 달력**은 주지 않았다. 여행자가 실제로 원하는 것은 그것이다.
 *
 * 정직성 규칙.
 *   여기 있는 띠는 전부 **구간**이지 날짜가 아니다.
 *   경계를 흐릿하게 그리는 것은 장식이 아니라 주장의 일부다 —
 *   장마가 6월 24일에 시작한다고 우리는 말할 수 없다.
 *
 * 출처: 기상청 계절 기후특성 보도자료, 산림청 단풍 절정 예측.
 */
interface Props { caption: string }
const { caption } = Astro.props;

const W = 760, H = 340, L = 156, R = 14, T = 40, B = 34;
const PW = W - L - R;
const mx = (m: number) => L + PW * m / 12;      // 0 = 1월 1일, 12 = 12월 31일

type Band = { label: string; sub: string; color: string; spans: [number, number][] };

const bands: Band[] = [
  { label: 'Cherry blossom', sub: 'south first, then north', color: '#dd8caa',
    spans: [[2.70, 3.70]] },
  { label: 'Easiest weather', sub: 'mild, dry, low rain', color: '#7f9e5b',
    spans: [[3.50, 5.15]] },
  { label: 'Monsoon · 장마', sub: 'humid, heavy bursts', color: '#5b8bc0',
    spans: [[5.62, 6.80]] },
  { label: 'Heat & tropical nights', sub: 'nights stay above 25°C', color: '#e07a4a',
    spans: [[6.28, 7.68]] },
  { label: 'Easiest weather', sub: 'the best window of the year', color: '#7f9e5b',
    spans: [[8.50, 10.15]] },
  { label: 'Autumn colour', sub: 'north-east first, then south', color: '#c9622e',
    spans: [[9.30, 10.50]] },
  { label: 'Snow', sub: 'west and south-west coasts', color: '#8fb4d4',
    spans: [[11.00, 12.00], [0, 1.93]] },
];

const rowY = (i: number) => T + 14 + i * 40;
const MONTHS = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="A month-by-month calendar of Korean seasons. Cherry blossom runs from late March into April. The easiest weather is mid-April to early June and again mid-September to early November. The monsoon runs from late June to late July, followed by heat and tropical nights from mid-July to late August. Autumn colour runs from mid-October to mid-November. Snow falls from December through February.">

    <defs>
      {bands.map((b, i) => (
        <linearGradient id={`g${i}`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color={b.color} stop-opacity="0.30" />
          <stop offset="0.18" stop-color={b.color} stop-opacity="0.92" />
          <stop offset="0.82" stop-color={b.color} stop-opacity="0.92" />
          <stop offset="1" stop-color={b.color} stop-opacity="0.30" />
        </linearGradient>
      ))}
    </defs>

    {MONTHS.map((m, i) => (
      <>
        <line x1={mx(i)} y1={T - 6} x2={mx(i)} y2={H - B} stroke="#ece4da" stroke-width="1" />
        <text x={mx(i + 0.5)} y={T - 12} text-anchor="middle" font-size="11.5"
              font-weight="600" fill="#8a827b">{m}</text>
        <text x={mx(i + 0.5)} y={H - B + 17} text-anchor="middle" font-size="10.5"
              fill="#a09890">{i + 1}</text>
      </>
    ))}
    <line x1={mx(12)} y1={T - 6} x2={mx(12)} y2={H - B} stroke="#ece4da" stroke-width="1" />

    {bands.map((b, i) => (
      <>
        <text x={L - 12} y={rowY(i) + 1} text-anchor="end" font-size="12.5"
              font-weight="600" fill="#12100f">{b.label}</text>
        <text x={L - 12} y={rowY(i) + 14} text-anchor="end" font-size="10"
              fill="#a09890">{b.sub}</text>
        {b.spans.map(([a, z]) => (
          <rect x={mx(a)} y={rowY(i) - 9} width={mx(z) - mx(a)} height="19"
                rx="9.5" fill={`url(#g${i})`} />
        ))}
      </>
    ))}
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; }
  figcaption {
    margin-top: 0.65rem; font-size: 0.86rem; line-height: 1.55; color: #6b6560;
  }
</style>
