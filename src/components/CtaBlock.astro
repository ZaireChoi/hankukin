---
/** Visit Korea / Bring Korea Home — 관련성이 있을 때만 렌더링한다 (문서 01 §4) */
import { isAffiliate, decorate } from '../config/merchants.mjs';
const { heading, items = [], note } = Astro.props;
const rel = { confirmed_use: 'Confirmed use', inspired_by: 'Inspired by', suggested: 'Suggested' };

/**
 * rel="sponsored" 는 '금전적 대가가 있는 링크' 를 뜻한다.
 * 제휴가 아닌 링크에 붙이면 검색엔진에도 사실과 다른 신고를 하는 셈이다.
 * 승인된 곳에만 sponsored 를 붙이고, 추적 태그도 그때만 붙는다.
 */
const prepared = items.map((i) => ({
  ...i,
  href: decorate(i.url, i.merchant),
  /*
   * 제휴가 아닌 링크에서 nofollow 를 뺐다 (2026-08-16 외부 지적).
   * 여기 걸리는 것은 코레일 예매·인천공항·궁능유적본부 같은 **공식 기관 페이지**다.
   * 우리가 독자에게 '여기서 하십시오' 라고 보내는 곳인데
   * nofollow 는 '이 링크를 보증하지 않는다' 는 뜻이다. 말과 신호가 어긋난다.
   * 승인된 제휴에는 sponsored 를 계속 붙인다 — 그건 성격이 다르다.
   */
  rel: isAffiliate(i.merchant) ? 'sponsored noopener' : 'noopener',
}));
---
{prepared.length > 0 && (
  <section class="block">
    <h2>{heading}</h2>
    <div class="cta-group">
      {prepared.map((i) => (
        <a class="cta" href={i.href} rel={i.rel} target="_blank">
          <span>
            <span class="l">{i.label}</span><br />
            <span class="m">{i.merchant} · <span class="rel">{rel[i.relationship] ?? i.relationship}</span></span>
          </span>
          <span class="arrow">→</span>
        </a>
      ))}
    </div>
    {note && <p class="notice">{note}</p>}
  </section>
)}
