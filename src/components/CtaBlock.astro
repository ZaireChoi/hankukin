---
/** Visit Korea / Bring Korea Home — 관련성이 있을 때만 렌더링한다 (문서 01 §4) */
import { isAffiliate, decorate } from '../config/merchants.mjs';
import { t } from '../config/ui.mjs';
/**
 * extra — 배송·재고처럼 **고지가 아닌 사실**만 받는다.
 * 제휴 여부를 여기에 적으면 안 된다. 그건 아래에서 링크로부터 계산된다.
 */
const { heading, items = [], extra, lang = 'en' } = Astro.props;

/**
 * 꼬리말은 **더 이상 호출하는 쪽에서 받지 않는다.** (2026-08-16 밤, 다섯 번째 재발)
 *
 *   now/[slug].astro 와 guides/[slug].astro 가 이 문장을 박아 두고 있었다:
 *     "None of these are affiliate links and nobody pays us for a place here"
 *   그런데 그 두 템플릿이 렌더링하는 인천공항 편·한복 편에는
 *   **오늘 승인된 Klook 링크(aid=131289)가 실제로 붙어 있다.**
 *   문장은 링크 바로 아래에서 거짓말을 하고 있었다.
 *
 *   8월 13일에 기사 하나에서 똑같은 거짓 고지를 고쳤고, 어제 푸터에서 또 고쳤다.
 *   그리고 오늘 CTA 에서 세 번째로 나왔다. 매번 **한 군데를 고치고 옆을 안 봤다.**
 *
 *   → 문장을 지우는 게 아니라 **문장을 못 쓰게 만든다.**
 *     note prop 을 없앴다. 꼬리말은 이 블록에 실제로 담긴 링크에서 계산된다.
 *     이제 틀리려면 링크 자체가 틀려야 한다.
 */
const anyPaid = items.some((i) => isAffiliate(i.merchant));
const allPaid = items.length > 0 && items.every((i) => isAffiliate(i.merchant));

const note = !items.length ? null
  : allPaid ? t(lang, 'affiliate.allPaid')
  : anyPaid ? t(lang, 'affiliate.somePaid')
  : t(lang, 'affiliate.nonePaid');
/**
 * 링크 옆 꼬리표.
 *
 * 2026-08-16 외부 지적 — 그리고 이건 전환율이 아니라 **법**의 문제다.
 *   제휴 링크에 'Klook · Suggested' 라고만 적혀 있었다.
 *   글 맨 위에 고지가 있긴 하지만 3,000단어 위다.
 *   FTC 는 제휴 관계를 **추천이나 링크에 가능한 한 가깝게** 밝히라고 한다.
 *   'Suggested' 는 편집 추천인지 수익 링크인지 구분해 주지 않는다.
 *
 * 그래서 꼬리표를 relationship 이 아니라 **isAffiliate 로 정한다.**
 *   제휴다      → 'Affiliate link — we may earn a commission'
 *   제휴가 아니다 → 기존 관계 표시. 여기에 affiliate 라고 쓰면 그것도 거짓이다.
 *
 * 둘 다 틀리지 않는 것이 요점이다. 없는 관계를 있다고 하는 것과
 * 있는 관계를 안 밝히는 것은 방향만 반대인 같은 잘못이다.
 */
const REL = t(lang, 'affiliate.rel');
const AFFILIATE_TAG = t(lang, 'affiliate.tag');

/**
 * rel="sponsored" 는 '금전적 대가가 있는 링크' 를 뜻한다.
 * 제휴가 아닌 링크에 붙이면 검색엔진에도 사실과 다른 신고를 하는 셈이다.
 * 승인된 곳에만 sponsored 를 붙이고, 추적 태그도 그때만 붙는다.
 */
const prepared = items.map((i) => ({
  ...i,
  href: decorate(i.url, i.merchant),
  /*
   * 제휴가 아닌 링크에서 nofollow 를 뺐다 (2026-08-16 외부 지적).
   * 여기 걸리는 것은 코레일 예매·인천공항·궁능유적본부 같은 **공식 기관 페이지**다.
   * 우리가 독자에게 '여기서 하십시오' 라고 보내는 곳인데
   * nofollow 는 '이 링크를 보증하지 않는다' 는 뜻이다. 말과 신호가 어긋난다.
   * 승인된 제휴에는 sponsored 를 계속 붙인다 — 그건 성격이 다르다.
   */
  rel: isAffiliate(i.merchant) ? 'sponsored noopener' : 'noopener',
}));
---
{prepared.length > 0 && (
  <section class="block">
    <h2>{heading}</h2>
    <div class="cta-group">
      {prepared.map((i) => (
        <a class="cta" href={i.href} rel={i.rel} target="_blank">
          <span>
            <span class="l">{i.label}</span><br />
            <span class="m">{i.merchant} · <span class={isAffiliate(i.merchant) ? 'rel paid' : 'rel'}>{isAffiliate(i.merchant) ? AFFILIATE_TAG : (REL[i.relationship] ?? i.relationship)}</span></span>
          </span>
          <span class="arrow">→</span>
        </a>
      ))}
    </div>
    {extra && <p class="notice">{extra}</p>}
    {note && <p class="notice">{note}</p>}
  </section>
)}
