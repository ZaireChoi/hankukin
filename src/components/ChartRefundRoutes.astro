---
/**
 * 영수증 한 장의 금액이 환급 경로를 정한다 — 세 갈래가 열리고 닫히는 지점.
 *
 * 왜 그렸나 (2026-09-02, 세금환급 편).
 *   이 기사에는 쓸 사진이 없다. 재고 305장 중 미사용분에는 계산대·TAX FREE 간판·
 *   출국장이 한 장도 없고, 명동 5장 중 유일한 미사용분인 myeongdong-2 는
 *   열어 보니 **명동성당**이었다 (벽돌 첨탑·잔디밭). 쇼핑 기사에 붙이면 오매칭이다.
 *   그래서 안경편·숫자편·클리닉편과 같은 판단으로 도표로 지탱한다.
 *
 *   그리고 이건 사진으로는 애초에 못 보여주는 것이다. 한국관광공사 페이지는
 *   세 경로의 한도를 **서로 다른 문단에** 흩어 적어 놓았다. 한 축에 얹으면
 *   「이 영수증은 어느 문으로 가야 하나」가 그림 한 장으로 끝난다.
 *
 * ⚠ 5,000,000원을 이 축에 올리지 않은 이유.
 *   그건 영수증 한 장의 한도가 아니라 **여행 전체의 누계**다. 차원이 다른 숫자를
 *   같은 축에 얹으면 그 순간 도표가 거짓말을 한다 (CLAUDE.md — 조건이 같을 때만 비교).
 *   각주로 따로 적었다.
 *
 * 축은 등간격으로 그렸고 실제 비율이 아니다. 그 사실을 도표 안에 적는다.
 */
interface Props { caption: string }
const { caption } = Astro.props;

const W = 760;
const LAB = 8, LABW = 198;
const AX0 = 212, AX1 = 748;
const SEG = (AX1 - AX0) / 4;            // 네 구간, 등간격
const x = (i) => AX0 + i * SEG;

const TOP = 92, RH = 44, GAP = 12;
const AXY = TOP + 3 * (RH + GAP) + 14;  // 축선
const H = AXY + 92;

const GREEN = '#3d6b46', ACCENT = '#c9622e', INK = '#12100f';
const SHUT = '#ece7e0', SHUT_LINE = '#ddd5cb';

/** open: 열려 있는 구간 번호 (0 = 15,000원 미만) */
const rows = [
  {
    en: 'Immediate refund at the till',
    ko: '즉시환급',
    open: [1],
  },
  {
    en: 'Downtown refund booth',
    ko: '시내 환급 창구',
    open: [1, 2],
  },
  {
    en: 'Airport or port counter',
    ko: '공항·항만 환급 창구 (또는 키오스크)',
    open: [1, 2, 3],
  },
];

const ticks = [
  { i: 1, label: '₩15,000' },
  { i: 2, label: '₩1,000,000' },
  { i: 3, label: '₩6,000,000' },
];
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="Three refund routes plotted against the amount on a single receipt. Below fifteen thousand won every route is closed and there is no refund at all. From fifteen thousand won up to one million won all three routes are open: immediate refund at the till, a downtown refund booth, and the airport or port counter. From one million to six million won the immediate refund at the till is closed, while the downtown booth and the airport remain open. Above six million won only the airport or port counter is open. A separate cap applies to immediate refunds: five million won across the whole trip, which is not a per-receipt figure and so is not drawn on this axis.">

    <text x={LAB} y="24" font-size="12" font-weight="700" fill="#8a827b" letter-spacing="0.08em">
      ONE RECEIPT, THREE DOORS — THE AMOUNT DECIDES WHICH ARE OPEN
    </text>

    <text x={LAB} y="52" font-size="11" font-weight="700" fill="#a09890" letter-spacing="0.06em">ROUTE</text>
    <text x={AX0} y="52" font-size="11" font-weight="700" fill="#a09890" letter-spacing="0.06em">
      AMOUNT ON THE RECEIPT →
    </text>

    {/* 구간 경계선 */}
    {[1, 2, 3].map((i) => (
      <path d={`M ${x(i)} ${TOP - 6} V ${AXY}`} stroke="#ded6cc" stroke-width="1" stroke-dasharray="3 3" fill="none" />
    ))}

    {rows.map((r, ri) => {
      const y = TOP + ri * (RH + GAP);
      return (
        <>
          <text x={LAB} y={y + 20} font-size="12.5" font-weight="700" fill={INK}>{r.en}</text>
          <text x={LAB} y={y + 37} font-size="11.5" fill="#8a827b">{r.ko}</text>

          {[0, 1, 2, 3].map((si) => {
            const isOpen = r.open.includes(si);
            return (
              <>
                <rect x={x(si) + 3} y={y} width={SEG - 6} height={RH} rx="4"
                      fill={isOpen ? GREEN : SHUT} fill-opacity={isOpen ? 0.16 : 1}
                      stroke={isOpen ? GREEN : SHUT_LINE} stroke-width={isOpen ? 1.6 : 1} />
                <text x={x(si) + SEG / 2} y={y + RH / 2 + 5} text-anchor="middle"
                      font-size="12" font-weight={isOpen ? 700 : 400}
                      fill={isOpen ? INK : '#a89f96'}>{isOpen ? 'open' : 'closed'}</text>
              </>
            );
          })}
        </>
      );
    })}

    {/* 축 */}
    <path d={`M ${AX0} ${AXY} H ${AX1}`} stroke="#b8b0a8" stroke-width="1.4" fill="none" />
    {ticks.map((t) => (
      <>
        <path d={`M ${x(t.i)} ${AXY} v 7`} stroke="#b8b0a8" stroke-width="1.4" fill="none" />
        <text x={x(t.i)} y={AXY + 24} text-anchor="middle" font-size="12" font-weight="700" fill={ACCENT}>{t.label}</text>
      </>
    ))}
    <text x={AX0 + SEG / 2} y={TOP - 16} text-anchor="middle" font-size="11.5" fill="#8a827b">nothing is refundable</text>
    <text x={AX1 - 6} y={TOP - 16} text-anchor="end" font-size="11.5" fill="#8a827b">no ceiling</text>

    <text x={LAB} y={AXY + 52} font-size="11.5" fill="#6b6560">
      The four steps are drawn the same width. The axis is not to scale.
    </text>
    <text x={LAB} y={AXY + 70} font-size="11.5" fill="#6b6560">
      Immediate refund carries a second cap — ₩5,000,000 across the whole trip. That is a running total, not a
    </text>
    <text x={LAB} y={AXY + 86} font-size="11.5" fill="#6b6560">
      receipt amount, so it is not on this axis. Amounts: Korea Tourism Organization, read 2 September 2026.
    </text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; }
  figcaption { margin-top: 0.65rem; font-size: 0.86rem; line-height: 1.55; color: #6b6560; }
</style>
