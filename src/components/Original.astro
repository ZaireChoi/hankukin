---
import { t } from '../config/ui.mjs';
import { LOCALES, DEFAULT_LOCALE } from '../config/brand.mjs';
/**
 * 원문 병기 — 우리가 읽은 한국어 문장을 그대로 보여준다.
 *
 * 왜 만들었나 (2026-08-16 운영자 지시: "AI 자동화의 냄새를 완전히 제거하자").
 *
 *   외부 평가가 이 사이트의 가장 큰 약점으로 '운영자의 실체 부족' 을 꼽았다.
 *   보통 이럴 때 쓰는 처방은 저자 소개 페이지다. 그런데 저자 소개는 **주장**이다.
 *   "저는 한국인이고 한국어 자료를 직접 읽습니다" 라고 쓰는 데는 아무 비용이 안 든다.
 *   누구나 쓸 수 있고, 그래서 아무것도 증명하지 못한다.
 *
 *   이 컴포넌트는 **증거**다.
 *
 *   우리 기사의 숫자는 전부 한국어 1차 출처에서 나왔고,
 *   영어권 경쟁자는 그 문장을 **읽을 수가 없다.** 그게 이 사이트의 유일한 해자다.
 *   그렇다면 그 문장을 숨길 이유가 없다. 페이지에 그대로 걸어 두면
 *   독자는 매번 이런 것을 본다:
 *
 *     주장 → 그 주장이 나온 한국어 원문 → 기관 이름 → 날짜 → 원문 링크
 *
 *   저자 소개 백 개보다 이 블록 하나가 강하다.
 *   그리고 **AI 요약이 가져갈 수 없다** — 요약할 것이 아니라 대조하는 것이기 때문이다.
 *
 * 인용의 한계 — 여기가 중요하다.
 *
 *   원문을 붙인다고 마음대로 길게 옮겨도 되는 게 아니다.
 *   실제로 코레일 보도자료는 **공공누리 제4유형(출처표시 + 상업적 이용금지 + 변경금지)** 이다.
 *   HANKUKIN 은 제휴·광고를 붙일 상업 사이트이므로 저 licence 로 본문을 옮길 수 없다.
 *
 *   우리가 서 있는 근거는 licence 가 아니라 **인용**이다 (저작권법 제28조).
 *   인용이 인용이려면 조건이 있다:
 *     · 짧을 것 — 원문을 대체해선 안 된다
 *     · 출처와 링크를 밝힐 것
 *     · 우리 글이 주(主)이고 인용이 종(從)일 것
 *
 *   그래서 이 컴포넌트는 **길이를 코드로 막는다.** 사람의 자제심에 맡기지 않는다.
 *   나중의 나를 포함해서, 급하면 누구나 한 문단씩 붙여 넣고 싶어진다.
 */
interface Props {
  /** 한국어 원문. 한 문장. 길면 빌드가 선다. */
  ko: string;
  /** 우리 번역. 의역하지 말 것 — 대조가 목적이다. */
  en: string;
  /** 기관 이름 (한국어). 예: 한국철도공사 보도자료 */
  who: string;
  /** 기관 이름 (영어). 독자는 한국어를 못 읽는다. */
  whoEn: string;
  /** 원문 날짜 YYYY-MM-DD */
  date: string;
  /** 원문 주소 */
  url: string;
}
const { ko, en, who, whoEn, date, url, lang: langProp } = Astro.props;
/*
 * 2026-08-17. en 은 **읽는 사람의 언어로 옮긴 것**이지 영어라는 뜻이 아니다.
 * 일본어판에서 이 자리에 영어가 나오면, 한국어를 못 읽는 사람에게
 * 또 하나의 못 읽는 언어를 보여주는 셈이 된다.
 * 이름은 en 그대로 두되(모든 기사가 이미 쓰고 있다), 뜻은 「독자의 언어」다.
 *
 * 2026-08-17 저녁, 같은 날 두 번째. 위 주석을 써 놓고 `lang = 'en'` 로 기본값을 뒀다.
 * 이 컴포넌트는 **MDX 안에서** 불린다. 기사 34곳에서 쓰는데 lang 을 넘긴 곳은 0곳이었고,
 * 그래서 일본어·중국어 기사 10편의 인용 블록마다
 * "The Korean sentence this comes from" 이 영어로 박혀 있었다.
 * ui.mjs 에 일본어·중국어 번역은 처음부터 있었다. **아무도 안 넘겼을 뿐이다.**
 *
 * → 기본값을 지운다. **주소에서 읽는다.** 필자가 잊을 수 있는 것은 잊게 되어 있다.
 *   prop 은 남겨 둔다(레이아웃에서 강제해야 할 때가 있다). 다만 이제 안 넘겨도 맞는다.
 */
const seg = Astro.url.pathname.split('/').filter(Boolean)[0];
const lang = langProp ?? (LOCALES.includes(seg) ? seg : DEFAULT_LOCALE);

/**
 * 인용 길이 상한. 한국어 120자.
 *
 * 왜 120인가: 보도자료의 사실 한 줄은 대개 60~100자다.
 * 120 이면 필요한 문장은 다 들어가고, 문단을 통째로 옮기려 하면 걸린다.
 * 상한이 없으면 언젠가 반드시 문단이 들어온다.
 */
const LIMIT = 120;
if (ko.length > LIMIT) {
  throw new Error(
    `원문 인용이 너무 깁니다 (${ko.length}자 / 상한 ${LIMIT}자).\n\n` +
    `  "${ko.slice(0, 60)}…"\n\n` +
    '이 블록의 근거는 공공누리 licence 가 아니라 **인용**입니다.\n' +
    '인용은 짧아야 인용입니다 — 길어지면 원문을 대체하게 되고,\n' +
    '그 순간 법적 근거가 사라집니다. 공공누리 제4유형(상업적 이용금지) 자료도 있습니다.\n\n' +
    '사실 한 줄만 남기고 나머지는 우리 문장으로 풀어 쓰십시오.\n',
  );
}
const dateLabel = new Date(date).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<figure class="original">
  <figcaption class="label">{t(lang, 'article.originalLabel')}</figcaption>

  {/*
    한국어를 먼저 놓는다. 번역을 위에 놓으면 원문이 각주처럼 보이는데,
    이 블록에서 주인공은 원문이다. 독자가 못 읽어도 상관없다 —
    **읽으라고 놓는 것이 아니라 있다는 것을 보이려고 놓는 것이다.**
    한국어를 아는 독자에게는 검증 수단이고, 모르는 독자에게는 증거다.
  */}
  <blockquote lang="ko" class="ko" cite={url}>{ko}</blockquote>

  <p class="en">{en}</p>

  <p class="who">
    <a href={url} rel="noopener" target="_blank">{whoEn}</a>
    <span lang="ko" class="ko-name">{who}</span>
    <span class="date">{dateLabel}</span>
  </p>
</figure>

<style>
  .original {
    margin: 2rem 0;
    padding: 1.15rem 1.35rem 1rem;
    border-left: 3px solid #c9622e;
    background: #fbf7f1;
    border-radius: 0 5px 5px 0;
  }
  .label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #a3714f;
    margin-bottom: 0.7rem;
  }
  /* 한국어는 영문 본문 서체로 찍으면 자간이 무너진다. 계통을 따로 준다. */
  .ko {
    margin: 0 0 0.7rem;
    padding: 0;
    border: 0;
    font-family: 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif;
    font-size: 1.02rem;
    line-height: 1.72;
    color: #12100f;
    word-break: keep-all;   /* 한국어는 낱말 중간에서 끊으면 안 읽힌다 */
  }
  .en {
    margin: 0 0 0.85rem;
    font-size: 0.94rem;
    line-height: 1.62;
    color: #4a443f;
  }
  .who {
    margin: 0;
    font-size: 0.79rem;
    color: #8a827b;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }
  .who a { color: #8a827b; text-decoration: underline; text-underline-offset: 2px; }
  .who a:hover { color: #c9622e; }
  .ko-name {
    font-family: 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif;
  }
  .ko-name::before { content: '· '; }
  .date::before { content: '· '; }
</style>
