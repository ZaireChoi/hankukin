---
import { t } from '../config/ui.mjs';
import { LOCALES, DEFAULT_LOCALE } from '../config/brand.mjs';
const { place, visit, lang: langProp } = Astro.props;
/*
 * 2026-08-17. 이 표의 라벨(Name·Address·Status…)과 영업상태 이름은 영어로만 있었다.
 * 촬영지 기사에 번역본이 아직 하나뿐이라 화면에 안 드러났을 뿐이다 —
 * **다음 번역본이 나오는 순간 절반이 영어인 페이지가 된다.**
 * 문구는 ui.mjs 로 옮기고, 언어는 주소에서 읽는다(부르는 쪽이 잊어도 맞도록).
 */
const seg = Astro.url.pathname.split('/').filter(Boolean)[0];
const lang = langProp ?? (LOCALES.includes(seg) ? seg : DEFAULT_LOCALE);
/** 영구폐업이면 예약·구매 CTA를 제거한다 (05 §4) — 이 플래그를 기사 페이지가 읽는다 */
---
<section class="block">
  <h2>{t(lang, 'place.heading')}</h2>
  <dl class="facts">
    <dt>{t(lang, 'place.name')}</dt><dd>{place.name}{place.nameKo && <> · {place.nameKo}</>}</dd>
    <dt>{t(lang, 'place.address')}</dt><dd>{place.address}</dd>
    <dt>{t(lang, 'place.status')}</dt><dd>{t(lang, 'place.statusLabel')[place.businessStatus]}</dd>
    {place.publicAccess === false && (<><dt>{t(lang, 'place.access')}</dt><dd>{t(lang, 'place.accessRestricted')}</dd></>)}
    <dt>{t(lang, 'place.bestSeason')}</dt><dd>{visit.bestSeason}</dd>
    <dt>{t(lang, 'place.gettingThere')}</dt><dd>{visit.gettingThere}</dd>
    {visit.transportCost && (<><dt>{t(lang, 'place.transport')}</dt><dd>{visit.transportCost}</dd></>)}
    {visit.admission && (<><dt>{t(lang, 'place.admission')}</dt><dd>{visit.admission}</dd></>)}
    {visit.whatToBring?.length > 0 && (<><dt>{t(lang, 'place.bring')}</dt><dd>{visit.whatToBring.join(', ')}</dd></>)}
  </dl>
  {place.safetyNotes && <p class="notice warn">{place.safetyNotes}</p>}
  <div class="cta-group" style="margin-top:.9rem">
    {place.mapUrl && (
      <a class="cta" href={place.mapUrl} rel="noopener" target="_blank" data-event="map_open">
        <span class="l">Open in Maps</span><span class="arrow">→</span>
      </a>
    )}
    {/* 장소의 **공식** 홈페이지다. 우리가 독자를 보내는 곳에 nofollow 를 붙이지 않는다
        (2026-08-16 — SourceList·Figure·CtaBlock 에 이어 네 번째 자리). */}
    {place.officialUrl && (
      <a class="cta" href={place.officialUrl} rel="noopener" target="_blank">
        <span class="l">Official page — check hours before you go</span><span class="arrow">→</span>
      </a>
    )}
  </div>
</section>
