---
/**
 * 남이섬 — 하루의 마감 시각들 (2026-09-08, Scenes 19편).
 *
 * 왜 그렸나.
 *   재고 332장에 남이섬·가평 사진이 **0장**이다 (슬러그 전체를 훑었다).
 *   그런데 이 기사의 요점은 애초에 사진으로 못 찍는 것이다 —
 *   **세 개의 마감 시각이 서로 다른 시간에 있다**는 것.
 *
 *     서울행 직행버스는 16:30 에 섬을 떠난다
 *     배는 그 뒤로도 4시간 반을 더 다닌다 (가을엔 5시간)
 *     가평역의 마지막 서울행은 그보다 또 두 시간 뒤다
 *
 *   표로 적으면 숫자 넷이 나란히 남지만, 한 시간축 위에 얹으면
 *   **버스를 예약한 사람이 섬의 절반을 못 본다**는 것이 눈에 보인다.
 *   그게 이 기사가 파는 한 가지다.
 *
 * 무엇이 우리 것인가.
 *   배 시각은 (주)남이섬 「선박운항」 페이지, 직행버스 시각은 같은 회사
 *   「오시는 길」 페이지, 열차 시각은 한국철도공사 「경의중앙선·경춘선
 *   (ITX-청춘)·서해선 전동열차 평일 시각표(2026.9.1.부터)」 원본 파일이다.
 *   우리가 만든 것은 **한 시간축 위의 배치**뿐이다.
 *
 *   23:32 편을 속 빈 눈금으로 그린 것도 우리 판단이 아니다 —
 *   그 열차의 종착역이 시각표에 「평내호(평)」으로 적혀 있다. 서울이 아니다.
 *
 * CJK 글꼴 주의.
 *   샌드박스 렌더러에 한글 글꼴이 없어 PNG 검수에서 한글이 네모로 나온다.
 *   그래서 이 도표에는 **한글도 ₩ 기호도 한 자 넣지 않았다.** 로마자와 숫자만 쓴다.
 *   (2026-09-08 아침 도표에서 ₩ 가 통째로 사라진 사고를 그대로 물려받은 규칙이다.)
 */
interface Props { caption: string }
const { caption } = Astro.props;

const W = 760;

const INK = '#12100f';
const MUTE = '#6b6560';
const FAINT = '#a09890';
const RULE = '#e0d9d0';

const BOAT = '#2f5fa8';
const BOAT_EXTRA = '#2f7d46';
const COACH = '#c0392b';
const RAIL = '#8a6d1f';

const LABEL_X = 24;
const PLOT_X = 232;
const PLOT_W = W - PLOT_X - 34;

const T0 = 7;    /* 07:00 */
const T1 = 24;   /* 24:00 */

const x = (h: number) => PLOT_X + ((h - T0) / (T1 - T0)) * PLOT_W;
const hm = (h: number, m: number) => h + m / 60;

const ROW_Y = 116;
const ROW_H = 66;

const rows = [
  {
    key: 'boat',
    name: 'Ferry, most of the year',
    sub: 'operator timetable',
    colour: BOAT,
    from: hm(8, 0),
    to: hm(21, 0),
    fromLabel: '08:00 first in',
    toLabel: '21:00 last in',
    note: 'Last boat off the island 21:05. Crossing about 5 minutes.',
  },
  {
    key: 'boat-extra',
    name: 'Ferry, 18 Sep - 22 Nov 2026',
    sub: 'added autumn service',
    colour: BOAT_EXTRA,
    from: hm(7, 30),
    to: hm(21, 30),
    fromLabel: '07:30 daily',
    toLabel: '21:30',
    note: 'The 21:30 boat runs Fri, Sat, Sun and public holidays only.',
  },
];

const coach = { depart: hm(16, 30), arrive: hm(18, 50) };

const trains = [
  { t: hm(22, 26), label: '22:26', dest: 'Cheongnyangni', hollow: false },
  { t: hm(22, 32), label: '22:32', dest: 'Yongsan, ITX', hollow: false },
  { t: hm(23, 11), label: '23:11', dest: 'Sangbong', hollow: false },
  { t: hm(23, 57), label: '23:57', dest: 'stops short', hollow: true },
];

const H = ROW_Y + 2 * ROW_H + 232;
const COACH_Y = ROW_Y + 2 * ROW_H;
const RAIL_Y = COACH_Y + 88;

/*
 * 열차 행만 축을 따로 쓴다 — 1차 렌더에서 실제로 깨졌기 때문이다 (2026-09-08 오후).
 * 마지막 네 편이 22:26·22:32·23:11·23:32 로 90분 안에 몰려 있어서,
 * 17시간짜리 축 위에 얹으면 눈금 넷이 오른쪽 끝 8% 구간에 겹쳐 붙고
 * 행선지 글자가 서로를 파고든다 ("Cheongn/Sangbong", "Yongsan,stops ITX short").
 * PNG 로 뽑아 눈으로 보고서야 알았다. 게이트는 이런 것을 못 잡는다.
 *
 * 그래서 이 행만 22:00~24:00 을 폭 전체에 편다. **확대라고 화면에 적는다** —
 * 적지 않으면 같은 축인 줄 알고 읽는다. 그게 도표가 거짓말하는 방식이다.
 */
const R0 = 22, R1 = 24;
const rx = (h: number) => PLOT_X + ((h - R0) / (R1 - R0)) * PLOT_W;

const hours = [7, 9, 11, 13, 15, 17, 19, 21, 23];
const pad = (n: number) => String(n).padStart(2, '0');
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={caption} xmlns="http://www.w3.org/2000/svg">
    <text x={LABEL_X} y="34" fill={INK} font-size="19" font-weight="700">
      One day at Nami Island, and its three separate deadlines
    </text>
    <text x={LABEL_X} y="58" fill={MUTE} font-size="13">
      The Seoul coach leaves the island long before the boats stop, and the trains keep going after that.
    </text>

    { hours.map((h) => (
      <g>
        <line x1={x(h)} y1={ROW_Y - 30} x2={x(h)} y2={COACH_Y + 14} stroke={RULE} stroke-width="1" />
        <text x={x(h)} y={ROW_Y - 38} fill={FAINT} font-size="11" text-anchor="middle">
          {pad(h)}:00
        </text>
      </g>
    )) }

    { rows.map((r, i) => {
      const y = ROW_Y + i * ROW_H;
      return (
        <g>
          <text x={LABEL_X} y={y} fill={INK} font-size="15" font-weight="700">{r.name}</text>
          <text x={LABEL_X} y={y + 18} fill={MUTE} font-size="12">{r.sub}</text>

          <rect x={x(r.from)} y={y - 13} width={x(r.to) - x(r.from)} height="15" rx="2"
                fill={r.colour} opacity="0.85" />
          <text x={x(r.from)} y={y - 20} fill={r.colour} font-size="11" font-weight="700">
            {r.fromLabel}
          </text>
          <text x={x(r.to)} y={y - 20} fill={r.colour} font-size="11" font-weight="700" text-anchor="end">
            {r.toLabel}
          </text>
          <text x={x(r.from)} y={y + 20} fill={FAINT} font-size="11">{r.note}</text>
        </g>
      );
    }) }

    <text x={LABEL_X} y={COACH_Y} fill={INK} font-size="15" font-weight="700">Seoul direct coach</text>
    <text x={LABEL_X} y={COACH_Y + 18} fill={MUTE} font-size="12">one departure a day</text>
    <line x1={x(coach.depart)} y1={COACH_Y - 16} x2={x(coach.depart)} y2={COACH_Y + 10}
          stroke={COACH} stroke-width="3" />
    <line x1={x(coach.depart)} y1={COACH_Y - 4} x2={x(coach.arrive)} y2={COACH_Y - 4}
          stroke={COACH} stroke-width="2" stroke-dasharray="3 3" />
    <circle cx={x(coach.arrive)} cy={COACH_Y - 4} r="4" fill={COACH} />
    <text x={x(coach.depart)} y={COACH_Y - 22} fill={COACH} font-size="11" font-weight="700">
      16:30 leaves the island
    </text>
    <text x={x(coach.arrive) + 8} y={COACH_Y} fill={MUTE} font-size="11">
      18:50 Hongdae
    </text>

    <line x1={LABEL_X} y1={RAIL_Y - 52} x2={W - 34} y2={RAIL_Y - 52} stroke={RULE} stroke-width="1" />
    <text x={LABEL_X} y={RAIL_Y} fill={INK} font-size="15" font-weight="700">Last trains from Gapyeong</text>
    <text x={LABEL_X} y={RAIL_Y + 18} fill={MUTE} font-size="12">weekday, toward Seoul</text>
    <text x={LABEL_X} y={RAIL_Y + 36} fill={COACH} font-size="11" font-weight="700">
      22:00 - 24:00, enlarged
    </text>
    <line x1={PLOT_X} y1={RAIL_Y + 6} x2={W - 34} y2={RAIL_Y + 6} stroke={RULE} stroke-width="1" />
    { [22, 23, 24].map((h) => (
      <text x={rx(h)} y={RAIL_Y + 22} fill={FAINT} font-size="10" text-anchor="middle">{pad(h)}:00</text>
    )) }
    { /* 22:26 과 22:32 는 6분 차이라 확대해도 라벨이 붙는다 — 위아래 두 층으로 어긋낸다 */ }
    { trains.map((t, i) => {
      const lv = i % 2;
      return (
        <g>
          <line x1={rx(t.t)} y1={RAIL_Y - 14 - lv * 16} x2={rx(t.t)} y2={RAIL_Y + 6}
                stroke={t.hollow ? FAINT : RAIL} stroke-width={t.hollow ? 1 : 3}
                stroke-dasharray={t.hollow ? '3 3' : undefined} />
          <text x={rx(t.t)} y={RAIL_Y - 22 - lv * 16} fill={t.hollow ? FAINT : RAIL}
                font-size="12" font-weight={t.hollow ? '400' : '700'} text-anchor="middle">
            {t.label}
          </text>
          <text x={rx(t.t)} y={RAIL_Y + 40 + lv * 15} fill={FAINT} font-size="10" text-anchor="middle">
            {t.dest}
          </text>
        </g>
      );
    }) }

    <text x={LABEL_X} y={H - 46} fill={FAINT} font-size="11">
      Ferry and coach times: Nami Island Co., Ltd., official schedule and access pages, read 8 September 2026.
    </text>
    <text x={LABEL_X} y={H - 30} fill={FAINT} font-size="11">
      Train times: Korea Railroad Corporation weekday timetable file for the Gyeongchun Line, in force from 1 September 2026.
    </text>
    <text x={LABEL_X} y={H - 14} fill={FAINT} font-size="11">
      The dotted 23:57 train is the last of the day and terminates at Pyeongnae-hopyeong, which is not Seoul.
    </text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart { margin: 2rem 0; }
  .chart svg { width: 100%; height: auto; display: block; }
  .chart figcaption {
    margin-top: 0.6rem;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--muted, #6b6560);
  }
</style>
