---
import { BRAND, LOCALES, HREFLANG, DEFAULT_LOCALE } from '../config/brand.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title,
  seoTitle = null,   // 검색 결과 전용 짧은 제목. 없으면 title 을 쓴다
  description = BRAND.defaultMetaDescription,
  lang = DEFAULT_LOCALE,
  path = '',              // 언어 세그먼트를 뺀 경로. 예: 'scenes/goblin-jumunjin-breakwater'
  jsonLd = null,
  noindex = false,
  /**
   * 공유 카드 이미지. 기사 페이지가 대표사진을 넘겨준다.
   *
   * 2026-08-14 외부 지적: og:image 가 없는데 twitter:card 는
   * summary_large_image 였다. "큰 사진 있다" 고 선언해 놓고 안 주는 것이라
   * 공유하면 깨진 카드가 나온다. 아예 없는 것보다 나빴다.
   * 이미지가 없으면 카드 종류를 summary 로 낮춘다 — 못 지킬 약속은 하지 않는다.
   */
  ogImage = null,
  ogType = 'website',
  publishedAt = null,
  modifiedAt = null,
} = Astro.props;

const site = Astro.site ?? new URL(`https://${BRAND.canonicalHost}`);
const clean = path.replace(/^\/|\/$/g, '');
/**
 * 정규 주소에는 **반드시 끝 슬래시를 붙인다.**
 *
 * 2026-08-16 에 잡은 버그. 예전 코드는 이랬다:
 *   `/${lang}/${clean}`.replace(/\/+$/, '/')
 * clean 은 이미 끝 슬래시를 뗀 문자열이라 저 replace 는 **아무것도 하지 않았다.**
 * 그래서 canonical 은 /en/now/foo 를 가리켰는데,
 *   · 실제 페이지 주소는 /en/now/foo/ (Cloudflare 가 308 로 되돌린다)
 *   · 바로 아래 breadcrumb 은 /en/now/foo/ 를 쓰고 있었다
 * **한 페이지 안에서 두 신호가 다른 주소를 가리켰다.** 30편 전부.
 *
 * 정규 주소·사이트맵·내부 링크는 한 글자도 다르면 안 된다.
 * 리다이렉트가 있으니 사람은 도착하지만, 색인은 그 사이에서 링크 가치를 흘린다.
 */
const canonical = new URL(clean ? `/${lang}/${clean}/` : `/${lang}/`, site).href;
/**
 * 검색 결과에 실제로 **보이는 길이**로 맞춘다 (2026-08-16).
 *
 * 문제였던 것: description 중앙값이 294자였다. 41개 중 160자 이하는 11개뿐.
 * 구글은 글자수 제한을 두지 않지만 결과 화면에서 잘라내고,
 * 잘릴 바에는 **구글이 본문에서 아무 문장이나 골라 다시 쓴다.**
 * 우리가 고른 문장이 잘리는 것보다 나쁜 건, 우리가 안 고른 문장이 대신 나가는 것이다.
 *
 * 다만 summary 자체를 줄이지는 않는다 — 그건 기사 첫머리에 그대로 실리는 글이고,
 * 거기서는 길이가 미덕이다. **검색용 요약과 읽기용 요약을 분리한다.**
 *
 * 자르는 방법: 문장 경계에서만 자른다. 말이 끊긴 요약은 안 쓰느니만 못하다.
 */
function forSearch(text, max = 155) {
  const t = (text ?? '').trim().replace(/\s+/g, ' ');
  if (t.length <= max) return t;
  const head = t.slice(0, max + 1);
  const cut = Math.max(head.lastIndexOf('. '), head.lastIndexOf('? '), head.lastIndexOf('! '));
  if (cut > 60) return head.slice(0, cut + 1);
  // 문장이 하나뿐이라 자를 데가 없으면 낱말 경계에서 끊고 말줄임표를 붙인다.
  const w = head.lastIndexOf(' ');
  return `${head.slice(0, w > 60 ? w : max)}…`;
}
const metaDescription = forSearch(description);

/**
 * 제목도 같은 문제였다. 사이트명까지 붙여 중앙값 66자, 최대 95자.
 * 62자를 넘으면 **사이트명을 뗀다** — 잘려서 사라질 바에는
 * 검색어가 들어 있는 본제목을 온전히 보여주는 편이 낫다.
 * 브랜드는 본문과 로고가 알려 준다. 검색 결과 한 줄을 브랜드에 쓰기엔 그 줄이 너무 비싸다.
 */
const searchTitle = seoTitle ?? title;
const withBrand = searchTitle ? `${searchTitle} — ${BRAND.name}` : BRAND.defaultMetaTitle;
const fullTitle = withBrand.length > 62 && searchTitle ? searchTitle : withBrand;

/**
 * 공유 카드 이미지 URL 을 절대경로로 만든다.
 * ogImage 는 { src, alt } 또는 Astro 의 이미지 객체를 받는다.
 */
const ogImageUrl = ogImage?.src
  ? new URL(typeof ogImage.src === 'string' ? ogImage.src : ogImage.src.src, site).href
  : null;
const ogImageAlt = ogImage?.alt ?? BRAND.name;

/** 빵부스러기 — 검색 결과에 경로가 표시되고, 사이트 구조를 검색엔진에 알려준다. */
const crumbs = clean ? clean.split('/') : [];
const breadcrumb = crumbs.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: BRAND.name, item: new URL(`/${lang}/`, site).href },
    ...crumbs.map((seg, i) => ({
      '@type': 'ListItem', position: i + 2,
      name: seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
      item: new URL(`/${lang}/${crumbs.slice(0, i + 1).join('/')}/`, site).href,
    })),
  ],
} : null;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: BRAND.name,
  url: site.href,
  slogan: BRAND.tagline,
  description: BRAND.defaultMetaDescription,
};
---
<!doctype html>
<html lang={HREFLANG[lang] ?? lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  {/* hreflang — Phase 1은 영어 단일이지만 구조를 미리 넣어둔다 (결정서 §4.2) */}
  {/*
    hreflang 에도 같은 버그가 있었다 (2026-08-16).
    canonical 을 고치면서 이 두 줄이 **같은 잘못된 관용구**를 쓰고 있는 걸 발견했다.
    한 군데를 고쳤으면 같은 모양이 또 어디 있는지 반드시 훑어야 한다.
  */}
  {LOCALES.map((l) => (
    <link rel="alternate" hreflang={HREFLANG[l] ?? l}
          href={new URL(clean ? `/${l}/${clean}/` : `/${l}/`, site).href} />
  ))}
  <link rel="alternate" hreflang="x-default"
        href={new URL(clean ? `/${DEFAULT_LOCALE}/${clean}/` : `/${DEFAULT_LOCALE}/`, site).href} />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={BRAND.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonical} />
  {ogImageUrl && <>
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:image" content={ogImageUrl} />
  </>}
  {ogType === 'article' && publishedAt &&
    <meta property="article:published_time" content={new Date(publishedAt).toISOString()} />}
  {ogType === 'article' && modifiedAt &&
    <meta property="article:modified_time" content={new Date(modifiedAt).toISOString()} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

  <link rel="alternate" type="application/rss+xml" title={BRAND.name} href="/rss.xml" />

  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  {/* 측정 ID가 설정된 경우에만 렌더링한다 — 더미 ID를 넣지 않는다 */}
  {BRAND.analytics.ga4MeasurementId && (
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${BRAND.analytics.ga4MeasurementId}`}></script>
  )}
</head>
<body>
  <Header lang={lang} />
  <main><slot /></main>
  <Footer lang={lang} />
</body>
</html>
