---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES } from '../../config/brand.mjs';
export async function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
---
<BaseLayout lang={lang} path="decode" title="HANKUKIN Decode" description="What Korean expressions actually mean beyond the subtitles — tone, politeness level, and the humour that translation drops." noindex={true}>
  <div class="wrap">
    <section class="hero">
      <p class="q">What It Means</p>
      <h1>HANKUKIN Decode</h1>
      <p>What Korean expressions actually mean beyond the subtitles — tone, politeness level, and the humour that translation drops.</p>
    </section>
    <section class="block">
      <p class="notice warn">This section is not published yet. It is scheduled for Phase 2, once
      enough weeks of signal data have been collected to say anything honest. This page is excluded
      from search engines until then.</p>
    </section>
  </div>
</BaseLayout>
