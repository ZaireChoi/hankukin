---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEFAULT_LOCALE, LOCALES, BRAND } from '../../config/brand.mjs';
import { AUTHOR, AUTHOR_I18N } from '../../config/author.mjs';
import PolicyNote from '../../components/PolicyNote.astro';
import { pageHref, isForeign } from '../../config/links.mjs';
import { t as ui } from '../../config/ui.mjs';

/*
 * 3개 언어로 전환했다 (2026-08-16).
 *
 * 이 페이지는 「누가 책임지는가」를 말하는 자리다.
 * 일·중 독자에게 그 답이 영어로만 있으면, 답하지 않은 것과 같다.
 * 문안은 config/author.mjs 의 AUTHOR_I18N 에 한 벌로 있다.
 */
export async function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const a = AUTHOR_I18N[lang] ?? AUTHOR_I18N.en;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR.name,
  description: AUTHOR.short,
  url: new URL(`/${lang}/author/`, `https://${BRAND.canonicalHost}`).href,
  knowsLanguage: ['ko', 'en'],
};
---

<BaseLayout availableLocales={LOCALES} lang={lang} path="author"
  title={`${AUTHOR.name} — ${a.title}`}
  seoTitle={a.h1}
  description={a.short}
  jsonLd={person}>

  <div class="wrap">
    <h1>{a.h1}</h1>

    <p class="lede">{a.lede}</p>

    <p class="name">{AUTHOR.name}</p>
    <p class="short">{a.short}</p>

    <h2>{a.factsHeading}</h2>
    {a.facts.map((f) => (
      <div class="fact">
        <h3>{f.claim}</h3>
        <p>{f.why}</p>
      </div>
    ))}

    <h2>{a.aiHeading}</h2>
    <p>{a.aiLeadA}<strong>{a.aiLeadStrong}</strong></p>
    <ul class="ai">{a.ai.map((x) => <li>{x}</li>)}</ul>

    <h2>{a.notHeading}</h2>
    {a.not.map(([k, v]) => <p><strong>{k}</strong>{v}</p>)}

    <h2>{a.wrongHeading}</h2>
    <p>
      <a href={pageHref(lang, 'contact')}>{ui(lang, 'byline.tellMe')}</a>{ui(lang, 'byline.wrongMid')}
      <a href={pageHref(lang, 'ledger')}>{ui(lang, 'byline.ledgerLink')}</a>
      {isForeign(lang, 'ledger') ? ui(lang, 'footer.inEnglish') : ''}
      {ui(lang, 'byline.wrongTail')}
    </p>

    <PolicyNote lang={lang} />
  </div>
</BaseLayout>

<style>
  .wrap { max-width: 42rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
  h1 { font-size: 2.1rem; line-height: 1.2; margin: 0 0 1.1rem; }
  h2 { font-size: 1.28rem; margin: 2.6rem 0 0.75rem; }
  h3 { font-size: 1rem; margin: 0 0 0.35rem; color: #c9622e; }
  p { line-height: 1.72; margin: 0 0 1rem; color: #2e2a27; }
  .lede { font-size: 1.12rem; color: #12100f; }
  .name { font-size: 1.5rem; font-weight: 700; margin: 1.8rem 0 0.3rem; }
  .short { color: #6b6560; margin-bottom: 0; }
  .fact { border-left: 2px solid #e0d8ce; padding-left: 1rem; margin-bottom: 1.4rem; }
  .fact p { margin: 0; font-size: 0.95rem; }
  ul.ai { padding-left: 1.1rem; margin: 0 0 1rem; }
  ul.ai li { line-height: 1.68; margin-bottom: 0.55rem; font-size: 0.95rem; color: #2e2a27; }
  a { color: #c9622e; }
</style>
