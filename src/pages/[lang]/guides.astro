---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES } from '../../config/brand.mjs';
export async function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
---
<BaseLayout lang={lang} path="guides" title="Culture & History" description="Longer reads on the history and culture behind the places and stories." noindex={true}>
  <div class="wrap">
    <section class="hero">
      <p class="q">Why It Matters</p>
      <h1>Culture & History</h1>
      <p>Longer reads on the history and culture behind the places and stories.</p>
    </section>
    <section class="block">
      <p class="notice warn">This section is not published yet. It is scheduled for Phase 2, once
      enough weeks of signal data have been collected to say anything honest. This page is excluded
      from search engines until then.</p>
    </section>
  </div>
</BaseLayout>
