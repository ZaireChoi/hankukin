---
/**
 * Korea Arrival Setup — 첫 24시간 동선 페이지.
 *
 * 2026-08-16 운영자 지시(외부 검토 수용): 새 글보다 이 페이지가 먼저다.
 * 이전에 두 번 보류했던 항목이나(노출 11회/일에 도구는 이르다), 운영자가
 * 우선순위를 뒤집었고, 지금 형태는 '도구'가 아니라 **기존 검증 기사 5편의 동선**이라
 * 새로 검증할 사실이 거의 없다 — 그래서 오늘 만들 수 있다.
 *
 * 규칙:
 *  · 상업 링크는 **이미 열어서 검증한 것만** 재사용한다 (data/link-verified.json).
 *    이 페이지를 위해 새 링크를 만들지 않았다.
 *  · 사실 주장은 전부 해당 기사로 보낸다. 이 페이지는 주장하지 않고 연결한다.
 *  · 숙소 단계는 링크 없이 정직하게 — 숙박 제휴(Agoda)는 심사 대기 중이고,
 *    서울 동네 선택 가이드는 아직 없다. 없는 것을 있는 척하지 않는다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import AffiliateTopNote from '../../components/AffiliateTopNote.astro';
import { DEFAULT_LOCALE, LOCALES } from '../../config/brand.mjs';
import { product } from '../../config/products.mjs';
import { getCollection } from 'astro:content';
import { publicSlug } from '../../config/slug.mjs';
import { pageHref, isForeign } from '../../config/links.mjs';
import { t } from '../../config/ui.mjs';

/*
 * 세 언어로 되돌렸다 (2026-08-17 저녁, 운영자 지시 "4번은 고쳐야지").
 *
 * 이 페이지는 홈에서 **가장 큰 버튼**이 가리키는 곳이다.
 * 그게 영어로만 있으면, 중국어 독자는 첫 클릭에서 영어를 만나고
 * 거기서 언어 전환도 막혔었다 — 오늘 운영자가 「갇힌다」고 한 그 문제의 뿌리다.
 *
 * 본문 문구는 ui.mjs 로 옮겼다. 각 단계가 가리키는 기사는
 * 그 언어에 있으면 그 언어로, 없으면 영어로 보내면서 「（英語）」를 적는다.
 */
export async function getStaticPaths() {
  const langs = await Promise.all(LOCALES.map(async (lang) => {
    const have = new Set();
    for (const c of ['now', 'guides', 'decode', 'hangul', 'scenes']) {
      const es = await getCollection(c, (e) => !e.data.draft && e.data.lang === lang);
      for (const e of es) have.add(`${c}/${publicSlug(e.id)}`);
    }
    return { params: { lang }, props: { have: [...have] } };
  }));
  return langs;
}
const { lang } = Astro.params;
const { have } = Astro.props;
const has = new Set(have);

/** 그 언어에 기사가 있으면 그 언어로, 없으면 영어로 보내고 표시한다. */
const art = (id) => has.has(id) ? `/${lang}/${id}/` : `/${DEFAULT_LOCALE}/${id}/`;
const artMark = (id) => (has.has(id) || lang === DEFAULT_LOCALE) ? '' : t(lang, 'footer.inEnglish');

const steps = [
  { n: 1, k: 's1', body: ['s1a', 's1b'], id: 'decode/korea-esim-no-phone-number', link: 's1link',
    cta: { heading: 's1cta', items: [product('klook-korea-esim', lang), product('skt-esim', lang), product('kt-esim', lang)] } },
  { n: 2, k: 's2', body: ['s2a', 's2b'], id: 'now/korea-3d-secure-card-declined-online', link: 's2link' },
  { n: 3, k: 's3', body: ['s3a', 's3b'], id: 'now/seoul-transport-fares-subway-bus-taxi', link: 's3link' },
  { n: 4, k: 's4', body: ['s4a'], id: 'now/incheon-airport-to-seoul-train-bus-taxi', link: 's4link',
    cta: { heading: 's4cta', items: [product('klook-arex-express', lang)] } },
  { n: 5, k: 's5', body: ['s5a'], id: null, link: 's5link' },
];

---
<BaseLayout availableLocales={LOCALES} lang={lang} path="arrival"
  title={t(lang, 'arrival.h1')}
  description={t(lang, 'arrival.metaDescription')}>
  <div class="wrap">
    <section class="hero">
      <p class="q">{t(lang, 'arrival.kicker')}</p>
      <h1>{t(lang, 'arrival.h1')}</h1>
      <p>{t(lang, 'arrival.lede')}</p>
    </section>

    <AffiliateTopNote lang={lang} items={steps.flatMap((s) => s.cta?.items ?? [])} />

    <section class="preflight">
      <h2>{t(lang, 'arrival.preflight')}</h2>
      <ul>
        <li>
          <a href={art('now/korea-3d-secure-card-declined-online')}>{t(lang, 'arrival.pre1')}</a>
          {artMark('now/korea-3d-secure-card-declined-online')} {t(lang, 'arrival.pre1Tail')}
        </li>
        <li>
          {t(lang, 'arrival.pre2')} <strong>{t(lang, 'arrival.pre2Strong')}</strong> {t(lang, 'arrival.pre2Tail')}
        </li>
        <li>
          <a href={art('guides/changdeokgung-secret-garden-booking')}>{t(lang, 'arrival.pre3')}</a>
          {artMark('guides/changdeokgung-secret-garden-booking')} {t(lang, 'arrival.pre3Tail')}
        </li>
      </ul>
    </section>

    {steps.map((s) => (
      <section class="step">
        <h2><span class="n">{s.n}</span>{t(lang, `arrival.${s.k}`)}</h2>
        {s.body.map((b) => <p>{t(lang, `arrival.${b}`)}</p>)}
        <p class="art">
          <a href={s.id ? art(s.id) : pageHref(lang, 'stuck')}>{t(lang, `arrival.${s.link}`)} →</a>
          {s.id ? artMark(s.id) : (isForeign(lang, 'stuck') ? t(lang, 'footer.inEnglish') : '')}
        </p>
        {s.cta && <CtaBlock lang={lang} heading={t(lang, `arrival.${s.cta.heading}`)} items={s.cta.items} />}
      </section>
    ))}

    <section class="step">
      <h2><span class="n">＋</span>{t(lang, 'arrival.sleep')}</h2>
      <p>{t(lang, 'arrival.sleepBody')}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero .q { font-size: .75rem; font-weight: 700; letter-spacing: .12em; color: #a0968a; margin-bottom: .4rem; }
  .preflight {
    margin: 0 0 2.2rem; padding: 1.2rem 1.4rem;
    background: #fbf7f1; border: 1px solid #ece3d7; border-radius: 8px;
  }
  .preflight h2 { font-size: 1.05rem; margin: 0 0 .6rem; }
  .preflight ul { margin: 0; padding-left: 1.1rem; }
  .preflight li { margin: .35rem 0; font-size: .95rem; line-height: 1.6; }
  .step { margin: 0 0 2.4rem; }
  .step h2 { font-size: 1.3rem; display: flex; align-items: baseline; gap: .6rem; }
  .step .n {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.7rem; height: 1.7rem; border-radius: 50%;
    background: #12100f; color: #fffdfa; font-size: .95rem; flex: none;
    transform: translateY(.15rem);
  }
  .step p { line-height: 1.7; }
  .step .art { font-size: .95rem; }
</style>
