---
/**
 * Korea Arrival Setup — 첫 24시간 동선 페이지.
 *
 * 2026-08-16 운영자 지시(외부 검토 수용): 새 글보다 이 페이지가 먼저다.
 * 이전에 두 번 보류했던 항목이나(노출 11회/일에 도구는 이르다), 운영자가
 * 우선순위를 뒤집었고, 지금 형태는 '도구'가 아니라 **기존 검증 기사 5편의 동선**이라
 * 새로 검증할 사실이 거의 없다 — 그래서 오늘 만들 수 있다.
 *
 * 규칙:
 *  · 상업 링크는 **이미 열어서 검증한 것만** 재사용한다 (data/link-verified.json).
 *    이 페이지를 위해 새 링크를 만들지 않았다.
 *  · 사실 주장은 전부 해당 기사로 보낸다. 이 페이지는 주장하지 않고 연결한다.
 *  · 숙소 단계는 링크 없이 정직하게 — 숙박 제휴(Agoda)는 심사 대기 중이고,
 *    서울 동네 선택 가이드는 아직 없다. 없는 것을 있는 척하지 않는다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import AffiliateTopNote from '../../components/AffiliateTopNote.astro';
import { DEFAULT_LOCALE, LOCALES } from '../../config/brand.mjs';
import { product } from '../../config/products.mjs';

/*
 * 이 페이지는 **영어판만 생성한다** (2026-08-17).
 *
 * 산문 정책 페이지는 아직 번역이 없다. LOCALES 전체로 돌리면
 * /ja/about/ 에 영어 본문이 그대로 뜬다 — 그건 「일본어판이 있다」가 아니라
 * 「일본어판이 미완성이다」이고, 검색엔진에도 언어 신호가 어긋난 페이지가 된다.
 *
 * 푸터는 이 사실을 알고 영어판으로 보내면서 「（英語）」라고 적는다.
 * 번역이 생기면 여기를 LOCALES 로 되돌리고 Footer 의 TRANSLATED_PAGES 에 넣는다.
 */
export async function getStaticPaths() { return [{ params: { lang: DEFAULT_LOCALE } }]; }
const { lang } = Astro.params;

const steps = [
  {
    n: 1,
    title: 'Get your phone working',
    /*
     * 2026-08-17 정정. 여기 이렇게 적혀 있었다:
     *   "A data-only Korean eSIM ... gives you a working 010 number."
     * eSIM 편은 같은 시각에 「이 상품은 번호가 없다」고 말하고 있었다.
     * 한 사이트가 두 말을 했고, 독자에게는 둘 다 우리 말이다.
     * 라벨은 이제 products.mjs 에서 가져온다 — 손으로 다시 쓰지 않는다.
     */
    body: [
      'Most tourist eSIMs sold through travel platforms are data-only: mobile data works, but there is no usable Korean 010 number, no calls and no SMS. Read the product page before you pay. ',
      'A data eSIM bought from a Korean carrier does carry an 010 number, and if you need to *send* texts — some booking apps demand it — the voice plans differ by carrier: SKT sells and verifies online (8am–10pm Korean time), KT and LG U+ hand over the QR at the airport counter.',
    ],
    article: { href: `/${lang}/decode/korea-esim-no-phone-number/`, label: 'The eSIM article — what a tourist eSIM can and cannot do' },
    cta: {
      heading: 'Get an eSIM',
      items: [product('klook-korea-esim', lang), product('skt-esim', lang), product('kt-esim', lang)],
    },
  },
  {
    n: 2,
    title: 'Make your cards work before you need them',
    body: [
      'Your foreign card will work in most shops and restaurants. Korean *online* checkouts are a different story — many run 3D Secure, and a card that is not enrolled gets declined with no useful explanation. ',
      'The fix is a phone call to your card issuer before you fly. Bring a second card from a different bank, and some cash.',
    ],
    article: { href: `/${lang}/now/korea-3d-secure-card-declined-online/`, label: 'The 3D Secure article — the call to make, and the three questions to ask' },
  },
  {
    n: 3,
    title: 'Pick up a transit card',
    body: [
      'T-money *(ti-meo-ni)* is the rechargeable card that works on subways and buses nationwide. Physical cards sell at airport convenience stores; some carrier eSIM bundles include one. ',
      'We are still verifying the mobile T-money apps on foreign phones — until then, the physical card is the answer we can stand behind.',
    ],
    article: { href: `/${lang}/now/seoul-transport-fares-subway-bus-taxi/`, label: 'What subway, bus and taxi rides actually cost' },
  },
  {
    n: 4,
    title: 'Get from the airport into the city',
    body: [
      'From Incheon: the all-stop train is the cheapest, the Express is the fastest rail option, limousine buses go door-ish to door, and after the last train the N6701/N6703 night buses are the option nobody tells you about.',
    ],
    article: { href: `/${lang}/now/incheon-airport-to-seoul-train-bus-taxi/`, label: 'Incheon → Seoul, compared — fares, times, and the 1am problem' },
    cta: {
      heading: 'Book airport transport',
      items: [
        { label: 'AREX Express train ticket — book ahead on Klook', url: 'https://www.klook.com/en-US/activity/1163-airport-to-seoul-city-center-arex-train-incheon/', merchant: 'Klook', category: 'transport', relationship: 'suggested' },
      ],
    },
  },
  {
    n: 5,
    title: 'Know the quirks before they find you',
    body: [
      'Korean trains have no ticket gates — sit in your assigned seat and that is the whole procedure. Clinics take walk-ins. Glasses take about ten minutes. And the signs stop being wallpaper after one evening with the alphabet.',
    ],
    article: { href: `/${lang}/stuck/`, label: 'The full list: every moment that stumps visitors, with one-line answers' },
  },
];
---
<BaseLayout lang={lang} path="arrival" title="Korea Arrival Setup: Your First 24 Hours"
  description="The five things to set up for landing in Korea — eSIM, cards and 3D Secure, T-money, airport transport, and the quirks — in order, with the checked details one click away.">
  <div class="wrap">
    <section class="hero">
      <p class="q">LANDING IN KOREA?</p>
      <h1>Arrival setup — your first 24 hours, in order</h1>
      <p>
        Five things, most of them doable from your sofa before you fly.
        Each step links to the full article where every number was checked against a Korean primary source.
      </p>
    </section>

    <AffiliateTopNote lang={lang} items={steps.flatMap((s) => s.cta?.items ?? [])} />

    <section class="preflight">
      <h2>Before you fly</h2>
      <ul>
        <li><a href={`/${lang}/now/korea-3d-secure-card-declined-online/`}>Call your card issuer about 3D Secure</a> — the one fix that only works from home.</li>
        <li>Buying an SKT voice eSIM online? Its passport verification runs <strong>8am–10pm Korean time</strong> — do it before the flight, not after landing at 1am.</li>
        <li><a href={`/${lang}/guides/changdeokgung-secret-garden-booking/`}>Secret Garden tickets</a> sell out ahead — if it is on your list, book it now.</li>
      </ul>
    </section>

    {steps.map((s) => (
      <section class="step">
        <h2><span class="n">{s.n}</span>{s.title}</h2>
        {s.body.map((p) => <p>{p}</p>)}
        <p class="art"><a href={s.article.href}>{s.article.label} →</a></p>
        {s.cta && <CtaBlock heading={s.cta.heading} items={s.cta.items} />}
      </section>
    ))}

    <section class="step">
      <h2><span class="n">＋</span>Where to sleep</h2>
      <p>
        The honest position: we do not have a Seoul neighbourhood guide yet, and we do not link
        hotels we have not evaluated. Our lodging advice so far lives in the regional articles —
        <a href={`/${lang}/scenes/gyeongju-at-night-silla-capital/`}> Gyeongju</a> and
        <a href={`/${lang}/scenes/geoje-island-what-to-see/`}> Geoje</a> carry price ranges by
        area type rather than named properties. A Seoul version is on the list.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero .q { font-size: .75rem; font-weight: 700; letter-spacing: .12em; color: #a0968a; margin-bottom: .4rem; }
  .preflight {
    margin: 0 0 2.2rem; padding: 1.2rem 1.4rem;
    background: #fbf7f1; border: 1px solid #ece3d7; border-radius: 8px;
  }
  .preflight h2 { font-size: 1.05rem; margin: 0 0 .6rem; }
  .preflight ul { margin: 0; padding-left: 1.1rem; }
  .preflight li { margin: .35rem 0; font-size: .95rem; line-height: 1.6; }
  .step { margin: 0 0 2.4rem; }
  .step h2 { font-size: 1.3rem; display: flex; align-items: baseline; gap: .6rem; }
  .step .n {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.7rem; height: 1.7rem; border-radius: 50%;
    background: #12100f; color: #fffdfa; font-size: .95rem; flex: none;
    transform: translateY(.15rem);
  }
  .step p { line-height: 1.7; }
  .step .art { font-size: .95rem; }
</style>
