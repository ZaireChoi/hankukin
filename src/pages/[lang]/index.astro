---
/**
 * 홈.
 *
 * 2026-08-15 개편. 외부 검토 지적: "홈페이지가 너무 비어 있다 — 큰 이미지가
 * 전혀 없고 최신 기사도 사실상 한 개만 노출된다. 실제로는 16개가 있는데
 * 홈에서 보이지 않는다."  맞는 말이었다. 이전 홈은 scenes 컬렉션만 나열했다.
 *
 * 쌓아 둔 글이 일하게 하려면 홈에서 보여야 한다.
 */
import { publicSlug } from '../../config/slug.mjs';
import { pageHref } from '../../config/links.mjs';
import { t } from '../../config/ui.mjs';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { BRAND, LOCALES, CATEGORIES } from '../../config/brand.mjs';

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;

/** 네 섹션을 한 줄로 모아 최신순으로 세운다. 섹션 이름은 카드의 머리말이 된다. */
const SECTIONS = [
  /**
   * Scenes 의 머리말은 **글마다 다르다** (2026-08-16 에 고침).
   *
   * 여기 'Filming location' 이 통째로 박혀 있었다.
   * 그런데 Scenes 다섯 편 중 촬영지 기사는 **한 편뿐**이고 넷은 sceneKind: culture 다.
   * 케데헌 검색추이 분석과 역주행 해설이 홈에서 '촬영지' 라고 소개되고 있었다.
   *
   * 외부 평가는 이걸 보고 "그 글들을 다른 축으로 옮기라" 고 했지만 그건 처방이 틀렸다.
   * K드라마·K팝·K무비·K공연을 다 Scenes 에 두는 것은 운영자가 내린 결정이고 그게 맞다.
   * **틀린 것은 분류가 아니라 라벨이다.** 분류를 바꿔 라벨을 맞추는 것은 거꾸로다.
   */
  { path: 'scenes', coll: 'scenes',
    kicker: (e, lang) => t(lang, e.data.sceneKind === 'location' ? 'home.kickers.filming' : 'home.kickers.kculture') },
  { path: 'now',    coll: 'now',    kicker: (e, lang) => t(lang, 'home.kickers.now') },
  { path: 'decode', coll: 'decode', kicker: (e, lang) => t(lang, 'home.kickers.decode') },
  // 한글 축이 홈에 아예 없었다. 상단 메뉴에는 있는데 목록에는 안 나왔다 —
  // 새 축을 만들면서 이 배열에 추가하는 것을 빠뜨렸다.
  // 읽히지 않는 축은 없는 축이다.
  { path: 'hangul', coll: 'hangul', kicker: (e, lang) => t(lang, 'home.kickers.hangul') },
  { path: 'guides', coll: 'guides', kicker: (e, lang) => t(lang, 'home.kickers.guides') },
];

const all = (await Promise.all(SECTIONS.map(async (s) => {
  const entries = await getCollection(s.coll, (e) => !e.data.draft && e.data.lang === lang);
  return entries.map((e) => ({
    href: `/${lang}/${s.path}/${publicSlug(e.id)}/`,
    kicker: s.kicker(e, lang),
    title: e.data.title,
    summary: e.data.summary,
    hero: e.data.hero ?? null,
    at: e.data.publishedAt,
    path: s.path,
  }));
}))).flat().sort((a, b) => b.at - a.at);

/** 대표 기사는 사진이 있는 것 중 가장 최신. 사진 없는 글을 첫 화면에 크게 걸 수 없다. */
const featured = all.find((a) => a.hero) ?? all[0];
const rest = all.filter((a) => a !== featured);
const latest = rest.slice(0, 6);

/** 섹션별 최신 3편 — 방문자가 무엇을 다루는 사이트인지 한 화면에서 알게 한다. */
const bySection = SECTIONS.map((s) => ({
  ...s,
  label: t(lang, `sections.${CATEGORIES.find((c) => c.path === s.path)?.key ?? 'now'}.label`),
  lead: t(lang, `sections.${CATEGORIES.find((c) => c.path === s.path)?.key ?? 'now'}.lead`),
  items: all.filter((a) => a.path === s.path).slice(0, 3),
})).filter((s) => s.items.length);

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: BRAND.name,
  itemListElement: all.slice(0, 12).map((a, i) => ({
    '@type': 'ListItem', position: i + 1, name: a.title,
    url: new URL(a.href, Astro.site).href,
  })),
};
---
<BaseLayout lang={lang} path="" jsonLd={jsonLd}
            ogImage={featured?.hero ?? null}>
  <div class="wrap">
    <section class="hero">
      <p class="q">Who brought you to Korea?</p>
      {/*
        2026-08-16 운영자 지적 두 건으로 교체.
        · "Bring Korea home" — 상품 축 기사가 0편이다. 간판이 콘텐츠를 앞서면 안 된다.
        · "Follow the story" — Scenes 5/33 으로 상대적으로 약하다.
        실전형으로 확정(운영자 선택). 상품 축이 생기면 그때 다시 논의한다.
      */}
      <h1>{t(lang, 'home.tagline')}<br />{t(lang, 'home.sub')}</h1>
      <p>{t(lang, 'home.metaDescription')}</p>
      {/* Arrival 동선 (2026-08-16 운영자 지시) — 한 줄 배너라 사진을 밀지 않는다 */}
      <p class="arrival-cta">
        <a href={pageHref(lang, 'arrival')}>{t(lang, 'home.arrivalCta')} <strong>{t(lang, 'home.arrivalCtaStrong')}</strong></a>
      </p>
    </section>

    {/*
      문제 색인(StuckIndex)은 홈에서 뺐다 (2026-08-16 운영자 결정, 세 번째 조정).

      경위: 어젯밤 16개를 대문 위에 → 사진이 밀린다는 지적으로 Latest 아래 6개로 →
      "없으면 더 좋겠다" 로 확정. 색인의 두 가치(문제 문장 = 검색어, 내부 동선)는
      전용 페이지 /stuck/ 와 대문의 Arrival 버튼이 대신한다. 홈은 사진이 일하는 곳이다.
      /stuck/ 의 실재-기사 게이트는 그대로 살아 있다.
    */}
    {featured && (
      <section class="block">
        <Card href={featured.href} hero={featured.hero} kicker={featured.kicker}
              title={featured.title} summary={featured.summary} big priority />
      </section>
    )}

    {latest.length > 0 && (
      <section class="block">
        <h2>Latest</h2>
        <div class="grid">
          {latest.map((a) => (
            <Card href={a.href} hero={a.hero} kicker={a.kicker} title={a.title} />
          ))}
        </div>
      </section>
    )}

    <section class="block">
      <h2>What we cover</h2>
      <div class="cards">
        {CATEGORIES.map((c) => (
          <a class="card" href={`/${lang}/${c.path}/`}>
            <div class="k">{t(lang, `sections.${c.key}.blurb`)}</div>
            <div class="v">{t(lang, `sections.${c.key}.label`)}</div>
          </a>
        ))}
      </div>
    </section>

    {bySection.map((s) => (
      <section class="block">
        <h2><a class="plain" href={`/${lang}/${s.path}/`}>{s.label}</a></h2>
        <p class="lead">{s.lead}</p>
        <ul class="sources">
          {s.items.map((a) => (
            <li><a href={a.href}>{a.title}</a></li>
          ))}
        </ul>
        <p class="more"><a href={`/${lang}/${s.path}/`}>All {s.label} articles →</a></p>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid; gap: 1.1rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .lead { margin: -.2rem 0 .8rem; color: #4a453f; font-size: .95rem; line-height: 1.6; }
  .arrival-cta { margin: .9rem 0 0; }
  .arrival-cta a {
    display: inline-block; padding: .55rem 1rem; border-radius: 6px;
    background: #12100f; color: #fffdfa; text-decoration: none; font-size: .95rem;
  }
  .arrival-cta a:hover { background: var(--accent, #c9622e); }
  .more { margin-top: .7rem; font-size: .9rem; }
  h2 .plain { color: inherit; text-decoration: none; }
  h2 .plain:hover { color: var(--accent); }
</style>
