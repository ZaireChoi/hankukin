---
/**
 * 「무엇이 막혔나요」 전체 목록 페이지.
 *
 * 2026-08-16: 홈에는 6개만 남기고(외부 검토 수용, 운영자 지시)
 * 16개 전체는 이 페이지가 담는다. 색인의 검증 게이트는 컴포넌트 안에 있다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import StuckIndex from '../../components/StuckIndex.astro';
import { DEFAULT_LOCALE, LOCALES } from '../../config/brand.mjs';
import { t } from '../../config/ui.mjs';
import { pageHref, isForeign } from '../../config/links.mjs';

/*
 * 세 언어로 되돌렸다 (2026-08-17 저녁).
 * 색인 자체가 언어별로 그려지므로, 이 페이지도 그 언어의 항목만 담는다.
 * 항목이 0개인 언어는 애초에 이 목록에 링크되지 않는다.
 */
export async function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
---
<BaseLayout availableLocales={LOCALES} lang={lang} path="stuck" title={t(lang, 'stuck.heading')}
  description={t(lang, 'stuck.metaDescription')}>
  <div class="wrap">
    <section class="hero">
      <h1>{t(lang, 'stuck.heading')}</h1>
      <p>
        {t(lang, 'stuck.pageLede')} <strong>{t(lang, 'stuck.pageLedeStrong')}</strong>{' '}
        {t(lang, 'stuck.pageArrival')}{' '}
        <a href={pageHref(lang, 'arrival')}>{t(lang, 'stuck.pageArrivalLink')}</a>
        {isForeign(lang, 'arrival') ? t(lang, 'footer.inEnglish') : ''}
      </p>
    </section>
    <StuckIndex lang={lang} mode="full" showHead={false} />
  </div>
</BaseLayout>
