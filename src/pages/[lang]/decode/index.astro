---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, categoryByPath } from '../../../config/brand.mjs';
import { t } from '../../../config/ui.mjs';
import { publicSlug } from '../../../config/slug.mjs';
export async function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;

// 제목·설명은 brand.mjs 한 곳에서 가져온다. 여기에 직접 적지 않는다 —
// 그렇게 했다가 Now 와 Decode 가 둘 다 'Culture & History' 를 달고 있었다 (2026-08-14).
const cat = categoryByPath('decode');

const items = (await getCollection('decode', (e) => !e.data.draft && e.data.lang === lang))
  .sort((a, b) => b.data.publishedAt - a.data.publishedAt);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: cat.label,
  itemListElement: items.map((g, i) => ({ '@type':'ListItem', position:i+1, name:g.data.title,
    url: new URL(`/${lang}/decode/${publicSlug(g.id)}/`, Astro.site).href })),
};
---
<BaseLayout lang={lang} path={cat.path} title={t(lang, `sections.${cat.key}.label`)}
  description={t(lang, `sections.${cat.key}.lead`)}
  jsonLd={jsonLd}>
  <div class="wrap">
    <section class="hero">
      <p class="q">{t(lang, `sections.${cat.key}.blurb`)}</p>
      <h1>{t(lang, `sections.${cat.key}.label`)}</h1>
      <p>{t(lang, `sections.${cat.key}.lead`)}</p>
    </section>
    <section class="block">
      <h2>All articles</h2>
      <ul class="sources">
        {items.map((g) => (
          <li>
            {/*
              2026-08-17 외부 검토: 목록에 「Korea · Korea」 가 반복되고 있었다.
              era 가 없으면 'Korea' 로 채우고, region 도 대개 'Korea' 라 같은 말이 두 번 나왔다.
              같은 말을 두 번 하면 정보가 아니라 **미완성으로 읽힌다.**
              → 중복은 지우고, 둘 다 없으면 아무것도 안 그린다. 빈 자리가 거짓 라벨보다 낫다.
            */}
            {(() => {
              const parts = [...new Set([g.data.era, g.data.region].filter(Boolean))];
              return parts.length ? <span class="st">{parts.join(' · ')}</span> : null;
            })()}
            <a href={`/${lang}/decode/${publicSlug(g.id)}/`}>{g.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
