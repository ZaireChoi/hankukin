---
/** Contact — 3개 언어. 본문은 src/config/policy.mjs 에 있다. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PolicyNote from '../../components/PolicyNote.astro';
import { BRAND, LOCALES } from '../../config/brand.mjs';
import { POLICY } from '../../config/policy.mjs';

export async function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const t = POLICY.contact[lang] ?? POLICY.contact.en;
---
<BaseLayout availableLocales={LOCALES} lang={lang} path="contact" title={t.title} description={t.description}>
  <div class="wrap policy">
    <h1>{t.h1}</h1>
    <p class="updated">{t.updated}</p>

    <p>{t.lead[0]}<strong>{BRAND.supportEmail}</strong>{t.lead[1]}</p>

    {t.blocks.map((b) => (b.h2 ? <h2>{b.h2}</h2> : <p>{b.p}</p>))}

    <PolicyNote lang={lang} />
  </div>
</BaseLayout>
