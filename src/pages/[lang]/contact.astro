---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BRAND, LOCALES } from '../../config/brand.mjs';
export async function getStaticPaths(){ return LOCALES.map((lang)=>({params:{lang}})); }
const { lang } = Astro.params;
---
<BaseLayout lang={lang} path="contact" title="Contact & Report an Error"
  description="Tell us about an out-of-date price, a closed venue, a wrong location or a translation that misses the point.">
  <div class="wrap policy">
    <h1>Contact &amp; Report an Error</h1>
    <p class="updated">Last updated 13 August 2026</p>

    <p>Email <strong>{BRAND.supportEmail}</strong>. We read everything, though we cannot promise an
    individual reply to every message.</p>

    <h2>Reporting something wrong</h2>
    <p>This is the most useful thing you can send us. Please include the page address and what you
    found — a venue that has closed, a price that has changed, a route that no longer runs, a
    location that is wrong, or a translation that misses the meaning.</p>
    <p>Where reports point to a substantive error, we withdraw the page from public view while we
    re-check it rather than leaving it up with a correction note.</p>

    <h2>Partnerships</h2>
    <p>If you run a venue, tour, studio or shop and want to work with us, write to the same address
    with what you do and where you are. We will tell you honestly whether our readers are a fit.</p>

    <h2>Rights holders</h2>
    <p>If you believe material on this site infringes your rights, contact us with the page address
    and a description of the material. We remove first and discuss afterwards.</p>
  </div>
</BaseLayout>
