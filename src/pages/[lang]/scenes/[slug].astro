---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ClaimBadge from '../../../components/ClaimBadge.astro';
import CtaBlock from '../../../components/CtaBlock.astro';
import AffiliateTopNote from '../../../components/AffiliateTopNote.astro';
import TranslationNote from '../../../components/TranslationNote.astro';
import SourceList from '../../../components/SourceList.astro';
import Byline from '../../../components/Byline.astro';
import ReadNext from '../../../components/ReadNext.astro';
import Figure from '../../../components/Figure.astro';
import PlaceFacts from '../../../components/PlaceFacts.astro';
import { NOTICES } from '../../../lib/claims.mjs';
import { BRAND, LOCALES } from '../../../config/brand.mjs';
import { AUTHOR } from '../../../config/author.mjs';
import { publicSlug } from '../../../config/slug.mjs';
import { pageHref } from '../../../config/links.mjs';
import { t } from '../../../config/ui.mjs';
import { anyAffiliate } from '../../../config/merchants.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('scenes', (e) => !e.data.draft);
  /*
   * 같은 slug 가 어떤 언어에 존재하는지 미리 센다 (2026-08-17).
   * hreflang 은 **실재하는 번역만** 선언해야 한다 —
   * 없는 언어를 선언하면 크롤러가 404 를 받고, 그건 「자기 사이트를 모른다」는 신호다.
   */
  const bySlug = new Map();
  for (const e of entries) {
    const k = publicSlug(e.id);
    if (!bySlug.has(k)) bySlug.set(k, []);
    bySlug.get(k).push(e.data.lang);
  }
  return LOCALES.flatMap((lang) =>
    entries.filter((e) => e.data.lang === lang).map((entry) => ({
      params: { lang, slug: publicSlug(entry.id) },
      props: { entry, availableLocales: bySlug.get(publicSlug(entry.id)) ?? [lang] },
    }))
  );
}

const { entry, availableLocales } = Astro.props;
const { lang, slug } = Astro.params;
const d = entry.data;
const { Content } = await render(entry);

/** 영구폐업 시 예약·구매 CTA 자동 제거 (05 §4) */
const isPlace = Boolean(d.place);
const closed = d.place?.businessStatus === 'permanently_closed';
const visitLinks = closed ? [] : d.visitKorea;

/**
 * 제휴 고지는 '링크가 있으니까' 띄우는 것이 아니라
 * '실제로 제휴 관계가 있으니까' 띄운다 (2026-08-13 수정).
 * 신청·승인 전에 수수료를 받는다고 쓰면 그건 거짓 고지다.
 */
const allLinks = [...visitLinks, ...d.bringKoreaHome];
const hasLinks = allLinks.length > 0;
const hasAffiliate = anyAffiliate(allLinks);
/*
 * 2026-08-17. 시간대 이름을 여기서 영어로 굳혀 두면 일본어판에도 Morning 이 나온다.
 * 실제로 나왔다 — 이 템플릿은 열여덟 절 중 여덟 절이 영어로 하드코딩돼 있었고,
 * 번역된 촬영지 기사(경주 야경) 두 쪽이 반쯤 영어인 채로 나가 있었다.
 * 화면 문구는 ui.mjs 로 옮긴다. 여기서는 키만 만든다.
 */
const slotLabel = t(lang, 'scene.slots');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: d.title,
      description: d.summary,
      datePublished: d.publishedAt.toISOString(),
      dateModified: d.checkedAt.toISOString(),
      inLanguage: lang,
  /**
   * author 와 image 는 검색 결과 표시에 쓰인다 (2026-08-14 외부 지적으로 추가).
   * 개인 필명을 만들지 않고 발행 주체를 그대로 쓴다 — 없는 사람을 지어내지 않는다.
   */
  // 조직이 아니라 **사람**이다 (2026-08-16). 조직명은 저자 신호로 일하지 않는다.
  author: { '@type': 'Person', name: AUTHOR.name, url: `https://${BRAND.canonicalHost}/${lang}/author/` },
  publisher: { '@type': 'Organization', name: BRAND.name },
  ...(d.hero ? { image: [new URL(d.hero.src.src, Astro.site ?? `https://${BRAND.canonicalHost}`).href] } : {}),
      about: { '@type': 'CreativeWork', name: d.work },
    },
    ...(d.place ? [{
      '@type': 'TouristAttraction',
      name: d.place.name,
      address: d.place.address,
      ...(d.place.lat && d.place.lng
        ? { geo: { '@type': 'GeoCoordinates', latitude: d.place.lat, longitude: d.place.lng } }
        : {}),
      ...(d.place.officialUrl ? { url: d.place.officialUrl } : {}),
    }] : []),
  ],
};
---
<BaseLayout availableLocales={availableLocales} title={d.title} seoTitle={d.seoTitle} description={d.summary} lang={lang}
            path={`scenes/${slug}`} jsonLd={jsonLd}
            ogType="article" ogImage={d.hero ?? null}
            publishedAt={d.publishedAt} modifiedAt={d.checkedAt}>
  <article class="wrap">

    <!-- 1·2·3. 제목 / 요약 / 작품·스타 -->
    <header class="article-head">
      <p class="kicker">HANKUKIN Scenes · {d.work}</p>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
      <div class="meta">
        {d.claimWording && <ClaimBadge wording={d.claimWording} />}
        {d.stars.length > 0 && <span>{d.stars.join(' · ')}</span>}
        <span>{t(lang, 'article.lastChecked')} {d.checkedAt.toISOString().slice(0,10)}</span>
      </div>
    </header>

    <AffiliateTopNote lang={lang} items={[...(visitLinks ?? []), ...(d.bringKoreaHome ?? [])]} />

    {closed && (
      <p class="notice warn">{t(lang, 'scene.closed')}</p>
    )}

    {hasAffiliate
      ? <p class="notice">{t(lang, 'notices.affiliate')}</p>
      : hasLinks && <p class="notice">{t(lang, 'notices.noAffiliate')}</p>}

    {d.hero && (
      <Figure src={d.hero.src} alt={d.hero.alt} credit={d.hero.credit}
              license={d.hero.license} sourceUrl={d.hero.sourceUrl}
              widths={[640, 960, 1280, 1600]} priority />
    )}

    <!-- 4·5. 장면이 중요한 이유 / 근거 (본문) -->
    <section class="block">
      <h2>{t(lang, 'article.sceneMatters')}</h2>
      <div class="prose"><Content /></div>
    </section>

    <!-- 6·7·8. 사진 재현 정보 — 촬영지 기사에만 있다 -->
    {d.photoTips && (
    <section class="block">
      <h2>{t(lang, 'scene.photoHeading')}</h2>
      <dl class="facts">
        <dt>{t(lang, 'scene.whereToStand')}</dt><dd>{d.photoTips.whereToStand}</dd>
        <dt>{t(lang, 'scene.direction')}</dt><dd>{d.photoTips.direction}</dd>
        <dt>{t(lang, 'scene.framing')}</dt><dd>{d.photoTips.orientation}{d.photoTips.zoom && <> · {d.photoTips.zoom}</>}</dd>
        <dt>{t(lang, 'scene.bestTime')}</dt><dd>{d.photoTips.bestTime}</dd>
        {d.photoTips.crowdTip && (<><dt>{t(lang, 'scene.crowdTip')}</dt><dd>{d.photoTips.crowdTip}</dd></>)}
        {d.photoTips.props.length > 0 && (<><dt>{t(lang, 'scene.props')}</dt><dd>{d.photoTips.props.join(', ')}</dd></>)}
      </dl>
      <p class="notice">{t(lang, 'notices.photoAngle')}</p>
    </section>
    )}

    <!-- 9·10·13. 장소·교통·비용 -->
    {d.place && d.visit && <PlaceFacts place={d.place} visit={d.visit} />}

    <!-- 11·12. 시간대별 주변 일정 -->
    {d.itinerary.length > 0 && (
      <section class="block">
        <h2>{t(lang, 'scene.itinerary')}</h2>
        <ol class="itin">
          {d.itinerary.map((s) => (
            <li>
              <span class="slot">{slotLabel[s.slot]}</span>
              <span><span class="t">{s.title}</span><br /><span class="d">{s.detail}</span></span>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- 14. 주변 문화·역사 -->
    {d.nearbyCulture && (
      <section class="block">
        <h2>{t(lang, 'scene.nearby')}</h2>
        <div class="prose"><p>{d.nearbyCulture}</p></div>
      </section>
    )}

    <!-- 15·16. 두 전환경로 -->
    <CtaBlock lang={lang} heading={t(lang, 'article.ctaVisit')} items={visitLinks} />
    <CtaBlock lang={lang} heading={t(lang, 'article.ctaBring')} items={d.bringKoreaHome}
              extra={t(lang, 'article.ctaShipNote')} />

    <!-- 17·18. 출처·확인일 / 고지 -->
    <ReadNext current={{ ...entry, _section: 'scenes' }} lang={lang} />

    <SourceList lang={lang} sources={d.sources} checkedAt={d.checkedAt} />
    <Byline lang={lang} />
    <section class="block">
      <p class="notice">{t(lang, 'byline.policyNote')}</p>
      <p class="notice">{t(lang, 'byline.spotted')}{' '}
        <a href={pageHref(lang, 'contact')}>{t(lang, 'byline.reportError')}</a>.</p>
    </section>

  </article>
</BaseLayout>
