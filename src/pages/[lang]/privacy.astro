---
/**
 * Privacy Policy — 3개 언어 (2026-08-16).
 *
 * 쿠키를 심는다는 사실을 읽는 사람이 못 읽는 언어로 적어 두면
 * 그건 고지가 아니다. 본문은 src/config/policy.mjs 에 있다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PolicyNote from '../../components/PolicyNote.astro';
import { BRAND, LOCALES } from '../../config/brand.mjs';
import { POLICY } from '../../config/policy.mjs';
import { pageHref } from '../../config/links.mjs';

export async function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const t = POLICY.privacy[lang] ?? POLICY.privacy.en;

const ext = (href, label) => ({ href, label });
const GOOGLE_PARTNER = ext('https://policies.google.com/technologies/partner-sites', 'policies.google.com/technologies/partner-sites');
const GOOGLE_ADS = ext('https://www.google.com/settings/ads', 'google.com/settings/ads');
const ABOUT_ADS = ext('https://www.aboutads.info/choices/', 'aboutads.info/choices');
---
<BaseLayout availableLocales={LOCALES} lang={lang} path="privacy" title={t.title} description={t.description}>
  <div class="wrap policy">
    <h1>{t.h1}</h1>
    <p class="updated">{t.updated}</p>

    <p>{t.leadA}{BRAND.primaryDomain}{t.leadB}</p>

    {t.blocks.map((b) => (
      b.h2 ? <h2>{b.h2}</h2>
      : b.raw === 'thirdParties' ? (
          <>
            <p><strong>{t.tpLead}</strong> {t.tpLeadB}</p>
            <ul>
              <li><strong>{t.tpAnalytics[0]}</strong> — {t.tpAnalytics[1]}</li>
              <li>
                <strong>{t.tpAdsName}</strong> — {t.tpAdsA}
                <a href={GOOGLE_PARTNER.href} rel="nofollow noopener" target="_blank">{GOOGLE_PARTNER.label}</a>
                {t.tpAdsB}
                <a href={GOOGLE_ADS.href} rel="nofollow noopener" target="_blank">{GOOGLE_ADS.label}</a>
                {t.tpAdsC}
                <a href={ABOUT_ADS.href} rel="nofollow noopener" target="_blank">{ABOUT_ADS.label}</a>
                {t.tpAdsD}
              </li>
              <li><strong>{t.tpAffiliate[0]}</strong> — {t.tpAffiliate[1]}</li>
            </ul>
          </>
        )
      : b.raw === 'children' ? (
          <p>{t.childrenA}<a href={pageHref(lang, 'editorial-policy')}>{t.childrenLink}</a>{t.childrenB}</p>
        )
      : b.raw === 'rights' ? <p>{t.rightsA}{BRAND.supportEmail}{t.rightsB}</p>
      : b.raw === 'email' ? <p>{BRAND.supportEmail}</p>
      : <p>{b.p}</p>
    ))}

    <PolicyNote lang={lang} />
  </div>
</BaseLayout>
