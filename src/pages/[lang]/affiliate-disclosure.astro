---
/**
 * Affiliate Disclosure — 3개 언어 (2026-08-16).
 *
 * 이 페이지를 영어로만 두는 것은 「고지했다」가 아니다.
 * 돈을 받는다는 사실은 읽는 사람의 언어로 적혀야 고지다.
 * 본문은 src/config/policy.mjs, 제휴사 목록은 merchants.mjs 에서 온다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PolicyNote from '../../components/PolicyNote.astro';
import { BRAND, LOCALES } from '../../config/brand.mjs';
import { MERCHANTS, isAffiliate } from '../../config/merchants.mjs';
import { POLICY } from '../../config/policy.mjs';
import { pageHref } from '../../config/links.mjs';

export async function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const t = POLICY['affiliate-disclosure'][lang] ?? POLICY['affiliate-disclosure'].en;

/**
 * 현재 제휴사 목록을 **등록부에서 읽는다** (2026-08-16 외부 지적).
 *
 * 이 페이지에 'Last updated 13 August' 이라고 손으로 적혀 있었는데
 * Klook 제휴는 8월 16일에 시작됐다. 사람이 갱신하기로 한 날짜는 반드시 어긋난다.
 * 그래서 목록도 날짜도 merchants.mjs 에서 가져온다.
 */
const live = Object.values(MERCHANTS).filter((m) => isAffiliate(m.name));
const lastChange = live.map((m) => m.approvedAt).sort().at(-1) ?? '2026-08-13';

/* 날짜도 그 언어의 표기로 쓴다 — 영어 날짜 형식이 남으면 그게 티가 난다 */
const DATE_LOCALE = { en: 'en-GB', ja: 'ja-JP', 'zh-hans': 'zh-CN', 'zh-hant': 'zh-TW' };
const asDate = (d) => new Date(d).toLocaleDateString(DATE_LOCALE[lang] ?? 'en-GB',
  { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout availableLocales={LOCALES} lang={lang} path="affiliate-disclosure"
  title={t.title} description={t.description}>
  <div class="wrap policy">
    <h1>{t.h1}</h1>
    <p class="updated">{t.updatedPrefix}{asDate(lastChange)}</p>

    <h2>{t.liveHeading}</h2>
    {live.length === 0
      ? <p><strong>{t.noneA}</strong>{t.noneB}</p>
      : <>
          <ul class="live">{live.map((m) => (
            <li><strong>{m.name}</strong> — {t.approved} {asDate(m.approvedAt)}</li>
          ))}</ul>
          <p class="note">{t.generated}</p>
        </>}

    <p>{t.leadA}<strong>{t.leadStrong}</strong></p>

    {t.blocks.map((b) => (
      b.h2 ? <h2>{b.h2}</h2>
      : b.raw === 'ads' ? (
          <p>{t.adsA}<a href={pageHref(lang, 'privacy')}>{t.adsLink}</a>{t.adsB}</p>
        )
      : b.raw === 'email' ? <p>{BRAND.supportEmail}</p>
      : <p>{b.p}</p>
    ))}

    <PolicyNote lang={lang} />
  </div>
</BaseLayout>
