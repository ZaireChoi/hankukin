---
/**
 * Editorial Policy — 3개 언어 (2026-08-16).
 *
 * about 과 privacy 가 이 페이지를 직접 링크한다.
 * 그 두 페이지를 일본어로 읽던 사람이 「編集方針」을 눌렀는데 영어가 나오면,
 * 방금 읽은 「AIの支援を受けて行っています」의 근거를 확인할 길이 사라진다.
 * 이 사이트에서 신뢰를 주장하는 문서가 바로 여기라서, 번역 우선순위가 높았다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PolicyNote from '../../components/PolicyNote.astro';
import { LOCALES } from '../../config/brand.mjs';
import { POLICY } from '../../config/policy.mjs';

export async function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const t = POLICY['editorial-policy'][lang] ?? POLICY['editorial-policy'].en;
---
<BaseLayout availableLocales={LOCALES} lang={lang} path="editorial-policy"
  title={t.title} description={t.description}>
  <div class="wrap policy">
    <h1>{t.h1}</h1>
    <p class="updated">{t.updated}</p>
    <p>{t.lead}</p>

    {t.blocks.map((b) => (
      b.h2 ? <h2>{b.h2}</h2>
      : b.ol ? <ol>{b.ol.map((i) => <li>{i}</li>)}</ol>
      : <p>{b.p}</p>
    ))}

    <PolicyNote lang={lang} />
  </div>
</BaseLayout>

<style>
  .policy ol { padding-left: 1.2rem; }
  .policy ol li { margin: .35rem 0; line-height: 1.6; }
</style>
