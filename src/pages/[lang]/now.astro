---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES } from '../../config/brand.mjs';
export async function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
---
<BaseLayout lang={lang} path="now" title="HANKUKIN Now" description="Weekly trend reports built from multiple public signals — search, shopping, music and media. Each card shows the evidence type and the observation window." noindex={true}>
  <div class="wrap">
    <section class="hero">
      <p class="q">What's Hot</p>
      <h1>HANKUKIN Now</h1>
      <p>Weekly trend reports built from multiple public signals — search, shopping, music and media. Each card shows the evidence type and the observation window.</p>
    </section>
    <section class="block">
      <p class="notice warn">This section is not published yet. It is scheduled for Phase 2, once
      enough weeks of signal data have been collected to say anything honest. This page is excluded
      from search engines until then.</p>
    </section>
  </div>
</BaseLayout>
