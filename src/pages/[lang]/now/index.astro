---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, categoryByPath } from '../../../config/brand.mjs';
export async function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;

// 제목·설명은 brand.mjs 한 곳에서 가져온다. 여기에 직접 적지 않는다 —
// 그렇게 했다가 Now 와 Decode 가 둘 다 'Culture & History' 를 달고 있었다 (2026-08-14).
const cat = categoryByPath('now');

const items = (await getCollection('now', (e) => !e.data.draft && e.data.lang === lang))
  .sort((a, b) => b.data.publishedAt - a.data.publishedAt);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: cat.label,
  itemListElement: items.map((g, i) => ({ '@type':'ListItem', position:i+1, name:g.data.title,
    url: new URL(`/${lang}/now/${g.id}/`, Astro.site).href })),
};
---
<BaseLayout lang={lang} path={cat.path} title={cat.label}
  description={cat.lead}
  jsonLd={jsonLd}>
  <div class="wrap">
    <section class="hero">
      <p class="q">{cat.blurb}</p>
      <h1>{cat.label}</h1>
      <p>{cat.lead}</p>
    </section>
    <section class="block">
      <h2>All articles</h2>
      <ul class="sources">
        {items.map((g) => (
          <li>
            <span class="st">{g.data.era ?? 'Korea'}{g.data.region ? ` · ${g.data.region}` : ''}</span>
            <a href={`/${lang}/now/${g.id}/`}>{g.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
