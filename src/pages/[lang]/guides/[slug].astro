---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SourceList from '../../../components/SourceList.astro';
import { NOTICES } from '../../../lib/claims.mjs';
import { LOCALES } from '../../../config/brand.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('guides', (e) => !e.data.draft);
  return LOCALES.flatMap((lang) =>
    entries.filter((e) => e.data.lang === lang).map((entry) => ({
      params: { lang, slug: entry.id }, props: { entry },
    }))
  );
}

const { entry } = Astro.props;
const { lang, slug } = Astro.params;
const d = entry.data;
const { Content } = await render(entry);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  datePublished: d.publishedAt.toISOString(),
  dateModified: d.checkedAt.toISOString(),
  inLanguage: lang,
  ...(d.region ? { contentLocation: { '@type': 'Place', name: d.region } } : {}),
};
---
<BaseLayout title={d.title} description={d.summary} lang={lang}
            path={`guides/${slug}`} jsonLd={jsonLd}>
  <article class="wrap">
    <header class="article-head">
      <p class="kicker">Culture &amp; History{d.era ? ` · ${d.era}` : ''}</p>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
      <div class="meta">
        {d.region && <span>{d.region}</span>}
        <span>Last checked {d.checkedAt.toISOString().slice(0,10)}</span>
      </div>
    </header>

    <section class="block">
      <div class="prose"><Content /></div>
    </section>

    <SourceList sources={d.sources} checkedAt={d.checkedAt} />

    <section class="block">
      <p class="notice">{NOTICES.aiAssisted}</p>
      <p class="notice">Spotted something wrong or out of date?
        <a href={`/${lang}/contact`}>Report an error</a>.</p>
    </section>
  </article>
</BaseLayout>
