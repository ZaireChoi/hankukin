---
/**
 * About — 3개 언어.
 *
 * 2026-08-16. 「껍데기까지 그 언어로」의 마지막 구멍을 막는다.
 * 본문은 src/config/policy.mjs 한 곳에 있다 — 영어도 거기 있다.
 * 영어만 .astro 에 두면 영어를 고칠 때 번역이 남는다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PolicyNote from '../../components/PolicyNote.astro';
import { BRAND, LOCALES } from '../../config/brand.mjs';
import { POLICY } from '../../config/policy.mjs';
import { pageHref } from '../../config/links.mjs';

export async function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const t = POLICY.about[lang] ?? POLICY.about.en;
---
<BaseLayout availableLocales={LOCALES} lang={lang} path="about" title={t.title} description={t.description}>
  <div class="wrap policy">
    <h1>{t.h1}</h1>
    <p class="updated">{t.updated}</p>

    {t.blocks.map((b) => (
      b.h2 ? <h2>{b.h2}</h2>
      : b.ul ? <ul>{b.ul.map(([k, v]) => <li><strong>{k}</strong> — {v}</li>)}</ul>
      : b.raw === 'madeWith' ? (
          <p>{t.madeWithA}<a href={pageHref(lang, 'editorial-policy')}>{t.madeWithLink}</a>{t.madeWithB}</p>
        )
      : b.raw === 'independence' ? (
          <p>{t.independenceA}<a href={pageHref(lang, 'affiliate-disclosure')}>{t.independenceLink}</a>{t.independenceB}</p>
        )
      : b.raw === 'contact' ? (
          <p>{BRAND.supportEmail}{t.contactA}<a href={pageHref(lang, 'contact')}>{t.contactLink}</a>{t.contactB}</p>
        )
      : <p>{b.p}</p>
    ))}

    <PolicyNote lang={lang} />
  </div>
</BaseLayout>
