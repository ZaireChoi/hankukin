---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SourceList from '../../../components/SourceList.astro';
import CtaBlock from '../../../components/CtaBlock.astro';
import AffiliateTopNote from '../../../components/AffiliateTopNote.astro';
import TranslationNote from '../../../components/TranslationNote.astro';
import Byline from '../../../components/Byline.astro';
import ReadNext from '../../../components/ReadNext.astro';
import Figure from '../../../components/Figure.astro';
import { NOTICES } from '../../../lib/claims.mjs';
import { BRAND, LOCALES } from '../../../config/brand.mjs';
import { AUTHOR } from '../../../config/author.mjs';
import { publicSlug } from '../../../config/slug.mjs';
import { makeHeroResolver } from '../../../config/hero.mjs';
import { t } from '../../../config/ui.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('hangul', (e) => !e.data.draft);
  /*
   * 같은 slug 가 어떤 언어에 존재하는지 미리 센다 (2026-08-17).
   * hreflang 은 **실재하는 번역만** 선언해야 한다 —
   * 없는 언어를 선언하면 크롤러가 404 를 받고, 그건 「자기 사이트를 모른다」는 신호다.
   */
  const bySlug = new Map();
  for (const e of entries) {
    const k = publicSlug(e.id);
    if (!bySlug.has(k)) bySlug.set(k, []);
    bySlug.get(k).push(e.data.lang);
  }
  /* 대표사진은 원문 한 곳에만 적혀 있다 — 번역본은 여기서 물려받는다 (config/hero.mjs) */
  const heroOf = makeHeroResolver(entries, 'hangul');
  return LOCALES.flatMap((lang) =>
    entries.filter((e) => e.data.lang === lang).map((entry) => ({
      params: { lang, slug: publicSlug(entry.id) },
      props: { entry, hero: heroOf(entry), availableLocales: bySlug.get(publicSlug(entry.id)) ?? [lang] },
    }))
  );
}

const { entry, hero, availableLocales } = Astro.props;
const { lang, slug } = Astro.params;
const d = entry.data;
const { Content } = await render(entry);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  datePublished: d.publishedAt.toISOString(),
  dateModified: d.checkedAt.toISOString(),
  inLanguage: lang,
  /**
   * author 와 image 는 검색 결과 표시에 쓰인다 (2026-08-14 외부 지적으로 추가).
   * 개인 필명을 만들지 않고 발행 주체를 그대로 쓴다 — 없는 사람을 지어내지 않는다.
   */
  // 조직이 아니라 **사람**이다 (2026-08-16). 조직명은 저자 신호로 일하지 않는다.
  author: { '@type': 'Person', name: AUTHOR.name, url: `https://${BRAND.canonicalHost}/${lang}/author/` },
  publisher: { '@type': 'Organization', name: BRAND.name },
  ...(hero ? { image: [new URL(hero.src.src, Astro.site ?? `https://${BRAND.canonicalHost}`).href] } : {}),
  ...(d.region ? { contentLocation: { '@type': 'Place', name: d.region } } : {}),
};
---
<BaseLayout availableLocales={availableLocales} title={d.title} seoTitle={d.seoTitle} description={d.summary} lang={lang}
            path={`hangul/${slug}`} jsonLd={jsonLd}
            ogType="article" ogImage={hero}
            publishedAt={d.publishedAt} modifiedAt={d.checkedAt}>
  <article class="wrap">
    <header class="article-head">
      {/*
        2026-09-08. 여기에 'Decode' 가 하드코딩돼 있었다. Hangul 기사 11편 전부가
        화면 맨 위에 「Decode」를 달고 나가고 있었고, 게이트 넷은 하나도 울지 않았다
        (라벨은 검사 대상이 아니다). decode 의 [slug].astro 를 복사해 오면서
        경로만 바꾸고 라벨을 안 바꾼 것이다 — 주제은행 2026-08-14 의
        「Now 와 Decode 목록 페이지가 둘 다 같은 제목을 달고 있었다」와 같은 사고이고,
        그때의 처방(「목록 페이지가 제목을 직접 적지 못하게 했다」)이 기사 페이지에는
        적용되지 않은 채 남아 있었다.
        d.era 도 함께 지웠다 — hangul 스키마에는 era 가 없다. 같은 복사의 흔적이다.
      */}
      <p class="kicker">{t(lang, 'sections.hangul.label')}</p>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
      <div class="meta">
        {d.region && <span>{d.region}</span>}
        <span>{t(lang, 'article.lastChecked')} {d.checkedAt.toISOString().slice(0,10)}</span>
      </div>
    </header>

    <TranslationNote lang={lang} translation={d.translation} />
    <AffiliateTopNote lang={lang} items={[...(d.visitKorea ?? []), ...(d.bringKoreaHome ?? [])]} />

    {hero && (
      <Figure src={hero.src} alt={hero.alt} credit={hero.credit}
              license={hero.license} sourceUrl={hero.sourceUrl}
              widths={[640, 960, 1280, 1600]} priority />
    )}

    <section class="block">
      <div class="prose"><Content /></div>
    </section>

    <ReadNext current={{ ...entry, _section: 'hangul' }} lang={lang} />

    <CtaBlock lang={lang} heading={t(lang, 'article.ctaHeading')} items={[...(d.visitKorea ?? []), ...(d.bringKoreaHome ?? [])]} />
    <SourceList lang={lang} sources={d.sources} />
    {/* 2026-08-22. 확인일 고지·편집방침·오류신고가 전부 Byline 안으로 들어갔다.
        상자 넷을 가는 선 하나로 바꿨고, 그중 둘은 같은 문장이라 합쳤다. */}
    <Byline lang={lang} checkedAt={d.checkedAt} />
  </article>
</BaseLayout>
