---
/**
 * 404.
 *
 * 2026-08-17 외부 검토 지적. 이 파일이 아예 없었다.
 *   없는 주소를 열면 404 가 아니라 홈으로 갔다.
 *   구글은 이것을 soft 404 로 본다 — "없다" 고 말해야 할 자리에서
 *   "여기 있다" 는 신호(200)를 보내는 것이라, 색인이 흐려진다.
 *
 * 실제로 우리 대장에 잘못된 주소가 하나 있었고, 그 주소를 눌러도
 * 404 가 안 나서 **아무도 깨진 걸 몰랐다.** 404 는 오류 화면이 아니라
 * 우리에게 오는 보고서다. 없애 두면 보고가 안 온다.
 *
 * Cloudflare Pages 는 정적 빌드의 404.html 을 404 상태 코드로 내보낸다.
 *
 * 그리고 이 페이지는 사과문이 아니라 **색인**이다.
 * 여기 온 사람은 뭔가를 찾다가 못 찾은 사람이고,
 * 우리 사이트에서 그 사람에게 가장 쓸모 있는 물건이 「무엇이 막혔나요」다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import StuckIndex from '../components/StuckIndex.astro';
import { DEFAULT_LOCALE, LOCALES } from '../config/brand.mjs';
import { t } from '../config/ui.mjs';

const lang = DEFAULT_LOCALE;

/*
 * 404 를 3개 언어로 만든다 (2026-08-16).
 *
 * 운영자가 /ja/privacy/ 를 눌렀을 때 이 화면이 떴는데, **영어였다.**
 * 일본어 주소로 들어온 사람에게 영어로 24줄짜리 목록을 보여준 것이다.
 *
 * 그런데 404.html 은 **파일 하나**다. 서버가 아무 주소에나 이 파일을 내주므로,
 * 빌드 시점에는 어떤 언어로 들어올지 알 수 없다. 언어별 404 를 따로 만들 수도 없다 —
 * 존재하지 않는 주소에는 /ja/ 든 /en/ 든 이 파일 하나가 나간다.
 *
 * 그래서 세 언어를 전부 담아 두고, 주소를 보고 고른다.
 * 스크립트가 막히면 영어가 남는다 — 지금과 같은 상태이므로 나빠지지 않는다.
 */

---
<BaseLayout
  title="That page is not here"
  description="The page you asked for does not exist on this site. Here is the list of problems we do have answers for."
  lang={lang}
  {/*
   * path 를 비워 둔다 (2026-08-17).
   *
   * path="404" 로 뒀더니 canonical 과 hreflang 이 /en/404/ 를 가리켰다.
   * **그런 주소는 존재하지 않는다** — 404.html 은 서버가 아무 주소에나 내주는 파일이다.
   * scripts/check-i18n.mjs 가 첫 실행에서 이걸 잡았다.
   * 없는 주소를 정규 주소라고 선언하는 것은, 404 페이지가 할 수 있는 최악의 일이다.
   */}
  path=""
  noindex={true}
>
  {LOCALES.map((l) => (
    <div class="l10n" data-lang={l} hidden={l !== DEFAULT_LOCALE}>
      <h1>{t(l, 'notFound.h1')}</h1>
      <p class="lede">
        {t(l, 'notFound.ledeA')}
        <a href={`/${l}/contact/`}>{t(l, 'notFound.tellUs')}</a>
        {t(l, 'notFound.ledeB')}
      </p>

      <StuckIndex lang={l} mode="full" />

      <p class="lede">
        {t(l, 'notFound.frontA')}<a href={`/${l}/`}>{t(l, 'notFound.frontLink')}</a>{t(l, 'notFound.frontB')}
      </p>
    </div>
  ))}

  <script is:inline define:vars={{ LOCALES, DEFAULT_LOCALE }}>
    /* 주소의 첫 칸이 언어면 그 언어를 보여준다. 아니면 영어 그대로. */
    const seg = location.pathname.split('/').filter(Boolean)[0];
    const pick = LOCALES.includes(seg) ? seg : DEFAULT_LOCALE;
    if (pick !== DEFAULT_LOCALE) {
      document.documentElement.lang = pick;
      for (const el of document.querySelectorAll('.l10n')) {
        el.hidden = el.dataset.lang !== pick;
      }
      const ttl = { ja: 'そのページはありません', 'zh-hans': '这个页面不在这里' }[pick];
      if (ttl) document.title = ttl + ' — HANKUKIN';
    }
  </script>

</BaseLayout>

<style>
  h1 { font-size: 1.9rem; letter-spacing: -0.015em; margin: 0 0 .8rem; }
  .lede { font-size: 1rem; line-height: 1.7; color: #4a453f; max-width: 42rem; margin: 0 0 2rem; }
</style>
